    }
    function lrPublicShape(l) {
      return l.keys().hasOnly(['bookingId', 'issuerId', 'issuerRole', 'customerId', 'fleetOwnerId', 'lrNo', 'seq', 'year', 'version',
                               'status', 'cancelReason', 'supersededBy', 'date', 'pickup', 'drop', 'route', 'goods', 'packages', 'weightTons',
                               'vehicleNumber', 'driverName', 'consignorName', 'consigneeName', 'issuerName', 'complianceMode',
                               'createdAt', 'updatedAt'])
          && l.keys().hasAll(['bookingId', 'issuerId', 'issuerRole', 'customerId', 'lrNo', 'seq', 'year', 'version', 'status', 'date', 'pickup', 'drop', 'goods', 'complianceMode', 'createdAt'])
          && l.issuerRole in ['transporter', 'customer']
          && l.seq is int && l.seq >= 1 && l.year is int && l.year >= 2024 && l.year <= 2100
          && l.version is int && l.version >= 1 && l.version <= 50
