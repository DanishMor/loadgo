                  && request.resource.data.data.action in ['payout_request', 'payout_details_changed', 'step_up_ok']
                  && request.resource.data.data.get('amountPaise', 0) is int))
          && (request.resource.data.type != 'otp_lock'
              || (request.resource.data.bookingId is string
                  && request.auth.uid in [get(docPath('bookings', request.resource.data.bookingId)).data.driverId, get(docPath('bookings', request.resource.data.bookingId)).data.get('assignedDriverId', '')]))
          && (!(request.resource.data.type in ['evidence', 'doc_view'])
              || (request.resource.data.bookingId is string
                  && request.auth.uid in [get(docPath('bookings', request.resource.data.bookingId)).data.driverId, get(docPath('bookings', request.resource.data.bookingId)).data.customerId]));
