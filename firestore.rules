    }
    function driverSharesUpi() {
      return resource.data.status != 'cancelled'
          && changedKeys().hasOnly(['payUpiId', 'updatedAt'])
          && request.resource.data.payUpiId is string
          && request.resource.data.payUpiId.matches('^[a-zA-Z0-9._-]{2,40}@[a-zA-Z]{2,20}$');
    }
    function stageClockOk(stage) {
      let before = resource.data.get('detention', {});
      let after = request.resource.data.get('detention', {});
      let startedKey = stage + 'StartedAt';
      let minutesKey = stage + 'Minutes';
      let wasRunning = startedKey in before;
