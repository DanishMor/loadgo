            && request.resource.data.keys().hasOnly(['freightPaise', 'advancePaise', 'balancePaise', 'marginPaise', 'gstPaise', 'consignorPhone', 'consigneePhone', 'createdAt'])
            && request.resource.data.createdAt == request.time
            && request.resource.data.get('freightPaise', 0) is int && request.resource.data.get('freightPaise', 0) >= 0
            && request.resource.data.get('advancePaise', 0) is int && request.resource.data.get('advancePaise', 0) >= 0
            && request.resource.data.get('balancePaise', 0) is int
            && request.resource.data.get('marginPaise', 0) is int
            && request.resource.data.get('gstPaise', 0) is int
