            && request.resource.data.keys().hasOnly(['from', 'candidate', 'sdpMid', 'sdpMLineIndex', 'createdAt'])
            && request.resource.data.from == request.auth.uid
            && request.resource.data.candidate is string && request.resource.data.candidate.size() <= 1000
            && request.resource.data.get('sdpMid', '') is string
