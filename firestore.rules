          && (!(request.resource.data.type in ['lr_issue', 'lr_version', 'lr_cancel', 'lr_share', 'lr_revoke', 'lr_mode', 'inspection_request', 'inspection_approve', 'inspection_deny', 'inspection_expire'])
              || (request.resource.data.bookingId is string
