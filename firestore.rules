                                   'freightPaise', 'advancePaise', 'balancePaise', 'marginPaise', 'gstPaise', 'consignorPhone', 'consigneePhone',
                                   'goodsValuePaise', 'invoiceNo', 'consignorGstin', 'consigneeGstin', 'ewayBillNo', 'ewayValidUntil'])
                 && (d.copyType != 'driver' || !f.keys().hasAny(['freightPaise', 'advancePaise', 'balancePaise', 'marginPaise', 'gstPaise', 'consignorPhone', 'consigneePhone', 'goodsValuePaise', 'invoiceNo', 'consignorGstin', 'consigneeGstin', 'ewayBillNo', 'ewayValidUntil']))
                 && (d.copyType != 'consignee' || !f.keys().hasAny(['marginPaise', 'consignorPhone', 'consigneePhone']))));
    }
    match /lr_shares/{token} {
      allow get: if resource.data.expiresAt > request.time && resource.data.revoked == false;
      allow list: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn()
          && token.matches('[0-9a-f]{32}')
