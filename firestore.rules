            && request.resource.data.driverId == driverId
            && request.resource.data.ownerId == get(docPath('lrs', lrId)).data.issuerId
            && request.resource.data.bookingId == get(docPath('lrs', lrId)).data.bookingId
            && lrTripDriver(get(docPath('bookings', get(docPath('lrs', lrId)).data.bookingId)).data)
            && request.resource.data.driverName is string && request.resource.data.driverName.size() <= 60
            && request.resource.data.status == 'pending'
            && request.resource.data.requestedAt == request.time;
        allow update: if signedIn()
            && ((driverId == request.auth.uid
                 && resource.data.status in ['denied', 'approved', 'expired']
                 && changedKeys().hasOnly(['status', 'requestedAt'])
                 && request.resource.data.status == 'pending'
                 && request.resource.data.requestedAt == request.time)
                || (get(docPath('lrs', lrId)).data.issuerId == request.auth.uid
                    && resource.data.status == 'pending'
                    && changedKeys().hasOnly(['status', 'decidedAt'])
                    && request.resource.data.status in ['approved', 'denied']
                    && request.resource.data.decidedAt == request.time)
                || (driverId == request.auth.uid
                    && resource.data.status == 'approved'
                    && changedKeys().hasOnly(['status', 'decidedAt'])
                    && request.resource.data.status == 'expired'
                    && request.resource.data.decidedAt == request.time
                    && exists(/databases/$(database)/documents/lrs/$(lrId)/inspection_grants/$(driverId))
                    && get(/databases/$(database)/documents/lrs/$(lrId)/inspection_grants/$(driverId)).data.expiresAt <= request.time));
        allow delete: if false;
