    function nextBookingStatus(s) {
      return {'accepted': 'driver_arriving', 'driver_arriving': 'loading', 'loading': 'picked_up',
              'picked_up': 'in_transit', 'in_transit': 'unloading', 'unloading': 'delivered'}.get(s, 'none');
    }
    function tripOtps(bookingId) {
      return get(/databases/$(database)/documents/bookings/$(bookingId)/secrets/otp).data;
    }
    function validPickupProof(p) {
      return p is map && p.keys().hasOnly(['packages', 'weightTons', 'sealNumber', 'damageNote'])
          && p.packages is int && p.packages > 0 && p.packages <= 100000
          && p.weightTons is number && p.weightTons > 0 && p.weightTons <= 100
          && p.sealNumber is string && p.sealNumber.size() <= 40
          && p.damageNote is string && p.damageNote.size() <= 300;
    }
    function validDeliveryProof(p) {
      return p is map && p.keys().hasOnly(['receiverName', 'receiverPhone', 'damageNote'])
          && p.receiverName is string && p.receiverName.size() >= 2 && p.receiverName.size() <= 60
          && p.receiverPhone is string && p.receiverPhone.matches('^$|^[+]?[0-9]{10,13}$')
          && p.damageNote is string && p.damageNote.size() <= 300;
    }
    function guessCommitted(bookingId, kind) {
      let p = /databases/$(database)/documents/bookings/$(bookingId)/otp_attempts/$(kind);
      return exists(p)
          && get(p).data.guess == tripOtps(bookingId)[kind + 'Otp']
          && get(p).data.guessAt > request.time - duration.value(10, 'm')
          && existsAfter(p) && getAfter(p).data.count == 0;
    }
    function driverStep(bookingId) {
      let before = resource.data.status;
      let after = request.resource.data;
      return after.status == nextBookingStatus(before)
          && ((!(after.status in ['picked_up', 'delivered'])
