              || (request.resource.data.status == 'closed' && request.resource.data.cancelReason in customerCancelReasons()))
          && !changedKeys().hasAny(['shipperId', 'driverId', 'bookingId', 'createdAt', 'promo', 'creditsUsedPaise', 'declaredValuePaise'])
          && validLoad(request.resource.data);
    }
    function posterCancelsWaiting() {
      return resource.data.shipperId == request.auth.uid
