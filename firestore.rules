              || (after.status == 'picked_up'
                  && changedKeys().hasOnly(['status', 'timeline', 'updatedAt', 'pickupOtp', 'pickupProof'])
                  && after.pickupOtp == tripOtps(bookingId).pickupOtp
                  && guessCommitted(bookingId, 'pickup')
                  && validPickupProof(after.pickupProof))
              || (after.status == 'delivered'
