          && request.resource.data.driverId == request.auth.uid
          && memberId == request.resource.data.ownerId + '_' + request.auth.uid
          && request.resource.data.active == true
          && request.resource.data.createdAt == request.time
          && get(docPath('users', request.auth.uid)).data.get('role', '') == 'driver'
          && getAfter(docPath('fleet_invites', request.resource.data.ownerId + '_' + phoneDigits(request.auth.token.get('phone_number', '')))).data.status == 'accepted'
