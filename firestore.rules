          && request.resource.data.customerId == get(docPath('bookings', request.resource.data.bookingId)).data.customerId
          && request.resource.data.get('fleetOwnerId', '') == get(docPath('bookings', request.resource.data.bookingId)).data.get('fleetOwnerId', '')
          && existsAfter(/databases/$(database)/documents/lrs/$(lrId)/private/details)
          && (request.resource.data.version == 1
