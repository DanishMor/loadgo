rules_version = '2';

// LoadGo Firestore security rules.
// Tests: firestore_rules_test/ (run against the emulator, see README there).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(id) {
      return signedIn() && request.auth.uid == id;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function docPath(collection, id) {
      return /databases/$(database)/documents/$(collection)/$(id);
    }

    // ------------------------------------------------------------------
    // users/{uid}: only the owner can read/write their own profile.
    // Drivers cannot approve themselves: verification fields may only be
    // initialised to pending/false; admins change them via Console/Admin SDK.
    // ------------------------------------------------------------------
    function verificationInitOk(d) {
      return d.get('verified', false) == false
          && d.get('verificationStatus', 'pending') == 'pending';
    }

    // Admins are allowlisted by an admins/{uid} document, created by hand in
    // the Firebase Console (rules never let a client write it). Admin powers
    // are listed per collection below.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function adminVerificationUpdate() {
      return isAdmin()
          && changedKeys().hasOnly(['verified', 'verificationStatus', 'verificationMeta', 'updatedAt'])
          && (!('verificationMeta' in request.resource.data)
              || (request.resource.data.verificationMeta.keys().hasOnly(['source', 'by', 'status', 'at'])
                  && request.resource.data.verificationMeta.source == 'manual_review'
                  && request.resource.data.verificationMeta.by == request.auth.uid
                  && request.resource.data.verificationMeta.status == request.resource.data.verificationStatus
                  && request.resource.data.verificationMeta.at == request.time))
          && request.resource.data.verificationStatus in ['pending', 'approved', 'rejected']
          && request.resource.data.verified == (request.resource.data.verificationStatus == 'approved');
    }

    // Free-text profile fields are capped (form input limits).
    function validProfileText(d) {
      return d.get('name', '') is string && d.get('name', '').size() <= 80
          && d.get('driverName', '') is string && d.get('driverName', '').size() <= 80
          && d.get('email', '') is string && d.get('email', '').size() <= 100
          && d.get('companyName', '') is string && d.get('companyName', '').size() <= 100;
    }

    // Optional profile extras: addresses (K6), business type (A5), payout UPI id (K8).
    function validProfileExtras(d) {
      return (!('addresses' in d)
              || (d.addresses is map && d.addresses.keys().hasOnly(['current', 'permanent'])
                  && d.addresses.get('current', '') is string && d.addresses.get('current', '').size() <= 200
                  && d.addresses.get('permanent', '') is string && d.addresses.get('permanent', '').size() <= 200))
          && (!('businessType' in d)
              || d.businessType in ['shipper', 'importer', 'exporter', 'trader', 'transporter'])
          && (!('payoutProfile' in d)
              || (d.payoutProfile is map && d.payoutProfile.keys().hasOnly(['upiId', 'holder'])
                  && d.payoutProfile.get('upiId', '') is string
                  && d.payoutProfile.get('upiId', '').matches('^$|^[a-zA-Z0-9._-]{2,40}@[a-zA-Z]{2,20}$')
                  && d.payoutProfile.get('holder', '') is string && d.payoutProfile.get('holder', '').size() <= 80));
    }

    // At most three {name, phone} emergency contacts on the profile.
    function validEmergencyContacts(d) {
      return !('emergencyContacts' in d)
          || (d.emergencyContacts is list && d.emergencyContacts.size() <= 3);
    }

    // Driver onboarding documents. Aadhaar is only ever the last four digits;
    // a full number cannot pass the regex. kycComplete needs the documents.
    function validKyc(d) {
      return (!('driverKyc' in d)
              || (d.driverKyc is map
                  && d.driverKyc.keys().hasOnly(['dlNumber', 'dlExpiry', 'rcNumber', 'aadhaarLast4', 'pan'])
                  && d.driverKyc.get('aadhaarLast4', '').matches('^[0-9]{4}$')
                  && d.driverKyc.get('pan', '').matches('^[A-Z]{5}[0-9]{4}[A-Z]$')
                  && d.driverKyc.get('dlNumber', '') is string && d.driverKyc.get('dlNumber', '').size() >= 8
                  && d.driverKyc.get('rcNumber', '') is string && d.driverKyc.get('rcNumber', '').size() >= 5
                  && d.driverKyc.get('dlExpiry', null) is timestamp))
          && (d.get('kycComplete', false) == false || 'driverKyc' in d);
    }

    // Driver's last known position, saved with a geohash for nearest-first
    // lists. Needs the location consent; the timestamp must be the server time.
    function validLastLocation(d) {
      return !('lastLocation' in d)
          || (d.get('consents', {}).get('location', false) == true
              && d.lastLocation is map
              && d.lastLocation.keys().hasOnly(['lat', 'lng', 'geohash', 'updatedAt'])
              && d.lastLocation.lat is number && d.lastLocation.lat >= -90 && d.lastLocation.lat <= 90
              && d.lastLocation.lng is number && d.lastLocation.lng >= -180 && d.lastLocation.lng <= 180
              && d.lastLocation.geohash is string
              && d.lastLocation.geohash.matches('^[0-9b-hjkmnp-z]{4,12}$')
              && d.lastLocation.updatedAt == request.time);
    }

    // identityHashes: type -> identity_index id (see identity_index below).
    function validIdentityHashes(d) {
      return !('identityHashes' in d)
          || (d.identityHashes is map
              && d.identityHashes.keys().hasOnly(['dl', 'pan', 'rc', 'gst'])
              && d.identityHashes.get('dl', '0').matches('^[0-9a-f]{64}$|^0$')
              && d.identityHashes.get('pan', '0').matches('^[0-9a-f]{64}$|^0$')
              && d.identityHashes.get('rc', '0').matches('^[0-9a-f]{64}$|^0$')
              && d.identityHashes.get('gst', '0').matches('^[0-9a-f]{64}$|^0$'));
    }

    // users.referralCode: set once, 6-8 capital letters / digits.
    function referralCodeOk(d) {
      return !('referralCode' in d) || (d.referralCode is string && d.referralCode.matches('^[A-Z0-9]{6,8}$'));
    }

    function referralCodeKept() {
      return !changedKeys().hasAny(['referralCode']) || resource.data.get('referralCode', null) == null;
    }

    // users.plan / planUntil: written by admins only (Pro plan, by hand).
    function planFieldsAbsent(d) {
      return !d.keys().hasAny(['plan', 'planUntil']);
    }

    function adminPlanUpdate() {
      return isAdmin()
          && changedKeys().hasOnly(['plan', 'planUntil', 'updatedAt'])
          && request.resource.data.get('plan', 'free') in ['free', 'pro']
          && (!('planUntil' in request.resource.data) || request.resource.data.planUntil is timestamp);
    }

    // users.docOverrideUntil: an admin lets a driver with an expired licence
    // work until that date (see canTransact). Admin-only.
    function adminDocOverride() {
      return isAdmin()
          && changedKeys().hasOnly(['docOverrideUntil', 'updatedAt'])
          && request.resource.data.docOverrideUntil is timestamp;
    }

    // Owners cannot write the review record; admins do (adminVerificationUpdate).
    function reviewMetaAbsent(d) {
      return !('verificationMeta' in d);
    }

    // Anti-fraud fields. riskTier/riskReason/riskUpdatedAt are admin-only;
    // cancelCount only goes up by one (see cancelCounted()).
    function riskFieldsAbsent(d) {
      return !d.keys().hasAny(['riskTier', 'riskReason', 'riskUpdatedAt', 'reviewFlag']) && d.get('cancelCount', 0) in [0, 1];
    }

    function ownerRiskFieldsUntouched() {
      return !changedKeys().hasAny(['riskTier', 'riskReason', 'riskUpdatedAt', 'reviewFlag'])
          && (!changedKeys().hasAny(['cancelCount'])
              || request.resource.data.cancelCount == resource.data.get('cancelCount', 0) + 1);
    }

    // K13: an admin marks a mismatch (name, RC owner, vehicle...) for manual
    // review, or clears it by removing the field. The owner cannot touch it.
    function adminReviewFlagUpdate() {
      let d = request.resource.data;
      return isAdmin()
          && changedKeys().hasOnly(['reviewFlag', 'updatedAt'])
          && (!('reviewFlag' in d)
              || (d.reviewFlag.keys().hasOnly(['kind', 'note', 'by', 'at'])
                  && d.reviewFlag.kind in ['name', 'rc_owner', 'vehicle', 'document', 'other']
                  && d.reviewFlag.note is string && d.reviewFlag.note.size() <= 200
                  && d.reviewFlag.by == request.auth.uid
                  && d.reviewFlag.at == request.time));
    }

    function adminRiskUpdate() {
      let d = request.resource.data;
      return isAdmin()
          && changedKeys().hasOnly(['riskTier', 'riskReason', 'riskUpdatedAt'])
          && d.riskTier in ['normal', 'review', 'restricted', 'suspended', 'banned']
          && d.riskReason is string && d.riskReason.size() <= 200
          && d.riskUpdatedAt == request.time;
    }

    // restricted / suspended accounts cannot post, offer or accept.
    // Riskier tiers and an expired licence (no admin override) cannot transact.
    function userMayTransact(u) {
      return u.get('riskTier', 'normal') in ['normal', 'review']
          && (!('driverKyc' in u)
              || u.driverKyc.get('dlExpiry', request.time) > request.time - duration.value(1, 'd')
              || u.get('docOverrideUntil', request.time) > request.time);
    }

    function canTransact(uid) {
      let p = /databases/$(database)/documents/users/$(uid);
      return !exists(p) || userMayTransact(get(p).data);
    }

    // A cancellation must bump the canceller's cancelCount in the same batch.
    function cancelCounted() {
      let ref = /databases/$(database)/documents/users/$(request.auth.uid);
      return getAfter(ref).data.get('cancelCount', 0)
          == (exists(ref) ? get(ref).data.get('cancelCount', 0) : 0) + 1;
    }

    // notificationPrefs / consents: maps of booleans with known keys only.
    function validBoolMap(d, field, keys) {
      return !(field in d)
          || (d[field] is map && d[field].keys().hasOnly(keys)
              && d[field].get(keys[0], false) is bool && d[field].get(keys[1], false) is bool && d[field].get(keys[2], false) is bool);
    }

    // Business profile: legal name, optional GSTIN in the official format
    // (format only, never verified), address.
    function validBusiness(d) {
      return !('business' in d)
          || (d.business is map && d.business.keys().hasOnly(['legalName', 'gstin', 'address'])
              && d.business.get('legalName', '') is string && d.business.get('legalName', '').size() <= 100
              && d.business.get('address', '') is string && d.business.get('address', '').size() <= 200
              && d.business.get('gstin', '') is string
              && d.business.get('gstin', '').matches('^$|^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$'));
    }

    function validNotificationPrefs(d) {
      return !('notificationPrefs' in d)
          || (d.notificationPrefs is map
              && d.notificationPrefs.keys().hasOnly(['bookingUpdates', 'ratings', 'promotions', 'payments', 'reminders'])
              && d.notificationPrefs.get('bookingUpdates', false) is bool
              && d.notificationPrefs.get('ratings', false) is bool
              && d.notificationPrefs.get('promotions', false) is bool
              && d.notificationPrefs.get('payments', false) is bool
              && d.notificationPrefs.get('reminders', false) is bool);
    }

    function validPrefs(d) {
      return validNotificationPrefs(d)
          && validBoolMap(d, 'consents', ['location', 'analytics', 'marketing']);
    }

    // `role` (customer | driver) is set once and then frozen; selectedRole
    // must keep matching it. Older accounts without `role` may set it once.
    function validRole(r) {
      return r == null || r in ['customer', 'driver', 'fleet'];
    }

    function roleLockOk() {
      let before = resource.data.get('role', null);
      let after = request.resource.data.get('role', null);
      return (before == null ? validRole(after) : after == before
              && request.resource.data.get('selectedRole', before) == before);
    }

    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow create: if isUser(userId) && verificationInitOk(request.resource.data)
          && validKyc(request.resource.data) && validProfileText(request.resource.data) && reviewMetaAbsent(request.resource.data) && planFieldsAbsent(request.resource.data) && !('docOverrideUntil' in request.resource.data) && referralCodeOk(request.resource.data) && validIdentityHashes(request.resource.data) && validLastLocation(request.resource.data) && validRole(request.resource.data.get('role', null))
          && (request.resource.data.get('role', null) == null
              || request.resource.data.get('selectedRole', request.resource.data.role) == request.resource.data.role)
          && validEmergencyContacts(request.resource.data) && validProfileExtras(request.resource.data) && riskFieldsAbsent(request.resource.data)
          && validPrefs(request.resource.data) && validBusiness(request.resource.data);
      allow update: if adminVerificationUpdate() || adminReviewFlagUpdate() || adminRiskUpdate() || adminPlanUpdate() || adminDocOverride() || (isUser(userId)
          && roleLockOk() && validKyc(request.resource.data) && validProfileText(request.resource.data) && !changedKeys().hasAny(['plan', 'planUntil', 'verificationMeta', 'docOverrideUntil']) && referralCodeOk(request.resource.data) && referralCodeKept() && validIdentityHashes(request.resource.data) && validLastLocation(request.resource.data)
          && validEmergencyContacts(request.resource.data) && validProfileExtras(request.resource.data)
          && validPrefs(request.resource.data) && validBusiness(request.resource.data)
          && ownerRiskFieldsUntouched()
          && (!changedKeys().hasAny(['verified', 'verificationStatus'])
              || (resource.data.get('verificationStatus', null) == null
                  && verificationInitOk(request.resource.data))));
      // Account deletion from the app. Restricted, suspended and banned
      // accounts go through support so a ban cannot be dodged.
      // TODO(functions): do the whole deletion with the Admin SDK.
      allow delete: if isUser(userId)
          && resource.data.get('riskTier', 'normal') in ['normal', 'review'];
    }

    // users/{uid}/admin_notes: internal notes about a user. Admins only, append-only.
    match /users/{userId}/admin_notes/{noteId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['by', 'text', 'createdAt'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // users/{uid}/blocked/{otherUid}: people this user does not want
    // messages from. Only the owner sees or changes the list.
    match /users/{userId}/blocked/{otherId} {
      allow read, delete: if isUser(userId);
      allow create, update: if isUser(userId) && otherId != userId
          && request.resource.data.keys().hasOnly(['createdAt']);
    }

    // users/{uid}/saved_places: the owner's frequent addresses.
    match /users/{userId}/saved_places/{placeId} {
      allow read, delete: if isUser(userId);
      allow create, update: if isUser(userId)
          && request.resource.data.keys().hasOnly(['label', 'name', 'address', 'createdAt'])
          && request.resource.data.label in ['home', 'office', 'warehouse', 'factory', 'port', 'cfs']
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
          && request.resource.data.address is string && request.resource.data.address.size() >= 2 && request.resource.data.address.size() <= 200;
    }

    // users/{uid}/saved_searches: named load / truck filters. The cap of 10
    // per kind is enforced by the app (rules cannot count).
    match /users/{userId}/saved_searches/{searchId} {
      allow read, delete: if isUser(userId);
      allow create, update: if isUser(userId)
          && request.resource.data.keys().hasOnly(['kind', 'name', 'filter', 'createdAt'])
          && request.resource.data.kind in ['loads', 'trucks']
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
          && request.resource.data.filter is map && request.resource.data.filter.size() >= 1 && request.resource.data.filter.size() <= 12
          && request.resource.data.filter.keys().hasOnly(['pickup', 'drop', 'from', 'to', 'vehicleType', 'minBudget', 'maxBudget',
                                                         'minWeight', 'maxWeight', 'minCapacity', 'onOrAfter', 'onOrBefore'])
          && request.resource.data.createdAt == request.time;
    }

    // users/{uid}/load_templates: loads the customer repeats (no dates).
    // The 20-template cap is enforced by the app (rules cannot count).
    match /users/{userId}/load_templates/{templateId} {
      allow read, delete: if isUser(userId);
      allow create, update: if isUser(userId)
          && request.resource.data.keys().hasOnly(['name', 'pickup', 'drop', 'cargoType', 'weight', 'vehicleType', 'budget', 'notes',
                                                   'pickupSlot', 'fragile', 'highValue', 'costCenter', 'createdAt'])
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
          && request.resource.data.pickup is string && request.resource.data.pickup.size() >= 2 && request.resource.data.pickup.size() <= 200
          && request.resource.data.drop is string && request.resource.data.drop.size() >= 2 && request.resource.data.drop.size() <= 200
          && request.resource.data.cargoType is string && request.resource.data.cargoType.size() <= 60
          && request.resource.data.weight is number && request.resource.data.weight > 0 && request.resource.data.weight <= 100
          && request.resource.data.vehicleType is string && request.resource.data.vehicleType.size() <= 40
          && (request.resource.data.get('budget', null) == null || (request.resource.data.budget is number && request.resource.data.budget > 0))
          && request.resource.data.get('notes', '') is string && request.resource.data.get('notes', '').size() <= 300
          && request.resource.data.get('pickupSlot', 'any') in ['any', 'morning', 'midday', 'afternoon', 'evening']
          && request.resource.data.get('fragile', false) is bool
          && request.resource.data.get('highValue', false) is bool
          && request.resource.data.get('costCenter', 'x') is string && request.resource.data.get('costCenter', 'x').size() <= 30
          && request.resource.data.createdAt == request.time;
    }

    // users/{uid}/recurring_loads: a shipment that repeats weekly or monthly.
    // Nothing posts by itself; the app offers it when due. The 10-per-user cap
    // is enforced by the app.
    match /users/{userId}/recurring_loads/{recurringId} {
      allow read, delete: if isUser(userId);
      allow create, update: if isUser(userId)
          && request.resource.data.keys().hasOnly(['name', 'pickup', 'drop', 'cargoType', 'weight', 'vehicleType', 'budget', 'notes',
                                                   'pickupSlot', 'fragile', 'highValue', 'costCenter', 'frequency', 'nextDueAt', 'active', 'createdAt'])
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
          && request.resource.data.pickup is string && request.resource.data.pickup.size() >= 2 && request.resource.data.pickup.size() <= 200
          && request.resource.data.drop is string && request.resource.data.drop.size() >= 2 && request.resource.data.drop.size() <= 200
          && request.resource.data.cargoType is string && request.resource.data.cargoType.size() <= 60
          && request.resource.data.weight is number && request.resource.data.weight > 0 && request.resource.data.weight <= 1000
          && request.resource.data.vehicleType is string && request.resource.data.vehicleType.size() <= 40
          && (request.resource.data.get('budget', null) == null || (request.resource.data.budget is number && request.resource.data.budget > 0))
          && request.resource.data.get('notes', '') is string && request.resource.data.get('notes', '').size() <= 300
          && request.resource.data.get('pickupSlot', 'any') in ['any', 'morning', 'midday', 'afternoon', 'evening']
          && request.resource.data.get('fragile', false) is bool
          && request.resource.data.get('highValue', false) is bool
          && request.resource.data.get('costCenter', 'x') is string && request.resource.data.get('costCenter', 'x').size() <= 30
          && request.resource.data.frequency in ['weekly', 'monthly']
          && request.resource.data.nextDueAt is timestamp
          && request.resource.data.active is bool;
    }

    // users/{uid}/favourite_drivers and blocked_drivers: private lists keyed by
    // the driver's uid. A blocked driver is copied onto new loads
    // (blockedDriverIds) so the driver cannot accept them; the app also hides
    // those loads from that driver's feed.
    match /users/{userId}/favourite_drivers/{driverId} {
      allow read, delete: if isUser(userId);
      allow create, update: if isUser(userId)
          && driverId != userId
          && request.resource.data.keys().hasOnly(['name', 'vehicleNumber', 'createdAt'])
          && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 60
          && request.resource.data.get('vehicleNumber', '') is string && request.resource.data.get('vehicleNumber', '').size() <= 12
          && request.resource.data.createdAt == request.time;
    }

    match /users/{userId}/blocked_drivers/{driverId} {
      allow read, delete: if isUser(userId);
      allow create, update: if isUser(userId)
          && driverId != userId
          && request.resource.data.keys().hasOnly(['name', 'createdAt'])
          && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 60
          && request.resource.data.createdAt == request.time;
    }

    // users/{uid}/branches: a business's warehouses, factories, ports, CFS.
    match /users/{userId}/branches/{branchId} {
      allow read, delete: if isUser(userId);
      allow create, update: if isUser(userId)
          && request.resource.data.keys().hasOnly(['type', 'name', 'address', 'city', 'createdAt'])
          && request.resource.data.type in ['warehouse', 'factory', 'port', 'cfs']
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 60
          && request.resource.data.address is string && request.resource.data.address.size() <= 200
          && request.resource.data.city is string && request.resource.data.city.size() <= 60
          && request.resource.data.createdAt == request.time;
    }

    // shipments/{id}: a two-leg import/export move that links two loads.
    // Immutable after creation; the loads carry the live status.
    match /shipments/{shipmentId} {
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['ownerId', 'kind', 'origin', 'hub', 'destination', 'containerNumber', 'sealNumber', 'leg1LoadId', 'leg2LoadId', 'createdAt'])
          && request.resource.data.ownerId == request.auth.uid
          && canTransact(request.auth.uid)
          && request.resource.data.kind in ['export', 'import']
          && request.resource.data.origin is string && request.resource.data.origin.size() >= 2 && request.resource.data.origin.size() <= 200
          && request.resource.data.hub is string && request.resource.data.hub.size() >= 2 && request.resource.data.hub.size() <= 200
          && request.resource.data.destination is string && request.resource.data.destination.size() >= 2 && request.resource.data.destination.size() <= 200
          && request.resource.data.containerNumber.matches('^$|^[A-Z]{4}[0-9]{7}$')
          && request.resource.data.sealNumber.matches('^$|^[A-Za-z0-9-]{1,20}$')
          && request.resource.data.leg1LoadId is string && request.resource.data.leg2LoadId is string
          && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // users/{uid}/favourite_routes: routes a driver wants recommendations for.
    match /users/{userId}/favourite_routes/{routeId} {
      allow read, delete: if isUser(userId);
      allow create, update: if isUser(userId)
          && request.resource.data.keys().hasOnly(['pickup', 'drop', 'createdAt'])
          && request.resource.data.pickup is string && request.resource.data.pickup.size() >= 2 && request.resource.data.pickup.size() <= 100
          && request.resource.data.drop is string && request.resource.data.drop.size() >= 2 && request.resource.data.drop.size() <= 100
          && request.resource.data.createdAt == request.time;
    }

    // ------------------------------------------------------------------
    // vehicles: any signed-in user can read (load matching); only the owner
    // can write. Numbers are reserved in vehicle_numbers/{number} so the same
    // registration cannot be added twice (across accounts). availability:
    // owner toggles available/maintenance (on_trip comes with bookings);
    // only admins suspend or lift a suspension.
    // ------------------------------------------------------------------
    function availabilityOf(d) {
      return d.get('availability', 'available');
    }

    // Document expiry. A vehicle whose insurance, permit or fitness paper has
    // run out (expiry before yesterday's midnight, day granularity) cannot take
    // bookings, and 'doc_expired' is the state the app puts it in. Only an
    // admin override (docOverrideUntil in the future) lifts that.
    function paperClear(d, kind) {
      return d.get('docs', {}).get(kind, {}).get('expiry', request.time) > request.time - duration.value(1, 'd');
    }

    function vehiclePapersClear(d) {
      return paperClear(d, 'insurance') && paperClear(d, 'permit') && paperClear(d, 'fitness');
    }

    function overrideActive(d) {
      return d.get('docOverrideUntil', request.time) > request.time;
    }

    function validVehicleDocs(d) {
      return !('docs' in d) || (d.docs is map
          && d.docs.keys().hasOnly(['insurance', 'puc', 'fitness', 'permit']));
    }

    // Optional cargo space (m), fuel and body type.
    function validDimension(d, k) {
      return !(k in d) || (d[k] is number && d[k] > 0 && d[k] <= 30);
    }

    function validVehicleProfile(d) {
      return validDimension(d, 'lengthM') && validDimension(d, 'widthM') && validDimension(d, 'heightM')
          && (!('fuel' in d) || d.fuel in ['diesel', 'petrol', 'cng', 'electric', 'lpg'])
          && (!('bodyType' in d) || d.bodyType in ['open', 'closed', 'container', 'flatbed', 'tanker', 'tipper', 'refrigerated', 'other']);
    }

    function validVehicle(d) {
      return d.keys().hasAll(['ownerId', 'number', 'type', 'capacity', 'status'])
          && d.number is string && d.number.size() >= 6 && d.number.size() <= 12
          && d.type is string && d.type.size() >= 1 && d.type.size() <= 40
          && d.get('rcNumber', '') is string && d.get('rcNumber', '').size() <= 30
          && d.capacity is number && d.capacity > 0 && d.capacity <= 1000
          && d.status in ['active', 'inactive']
          && availabilityOf(d) in ['available', 'on_trip', 'maintenance', 'suspended', 'doc_expired']
          && validVehicleDocs(d)
          && (!('nextServiceDate' in d) || d.nextServiceDate is timestamp)
          && (!('nextTyreCheckDate' in d) || d.nextTyreCheckDate is timestamp)
          && validVehicleProfile(d)
          && (!('assignedDriverId' in d) || (d.assignedDriverId is string && d.assignedDriverId.size() >= 1 && d.assignedDriverId.size() <= 60))
          // RC photo must point at Firebase Storage when present.
          && (!('rcImageUrl' in d) || (d.rcImageUrl is string
              && d.rcImageUrl.matches('https://firebasestorage[.]googleapis[.]com/.*|http://(127[.]0[.]0[.]1|localhost|10[.]0[.]2[.]2):9199/.*')));
    }

    function numberReservedFor(vehicleId, number) {
      return existsAfter(docPath('vehicle_numbers', number))
          && getAfter(docPath('vehicle_numbers', number)).data.vehicleId == vehicleId;
    }

    function ownerAvailabilityOk() {
      let before = availabilityOf(resource.data);
      let after = availabilityOf(request.resource.data);
      return (before == after || (before != 'suspended' && after != 'suspended'))
          && (before != 'doc_expired' || after == 'doc_expired' || vehiclePapersClear(request.resource.data) || overrideActive(resource.data));
    }

    // A fleet owner assigns a vehicle to one of their active drivers
    // (fleet_members); that driver can then take loads with it and flip it
    // between available and on_trip.
    function activeMember(ownerId, driverId) {
      return exists(docPath('fleet_members', ownerId + '_' + driverId))
          && get(docPath('fleet_members', ownerId + '_' + driverId)).data.active == true;
    }

    function assignmentOk() {
      let now = request.resource.data.get('assignedDriverId', null);
      return now == resource.data.get('assignedDriverId', null)
          || now == null
          || (now is string && activeMember(request.auth.uid, now));
    }

    function assignedDriverAvailability() {
      return resource.data.get('assignedDriverId', '') == request.auth.uid
          && changedKeys().hasOnly(['availability', 'updatedAt'])
          && availabilityOf(resource.data) in ['available', 'on_trip']
          && request.resource.data.availability in ['available', 'on_trip'];
    }

    match /vehicles/{vehicleId} {
      allow read: if signedIn();
      allow create: if signedIn()
          && request.resource.data.ownerId == request.auth.uid
          && validVehicle(request.resource.data)
          && availabilityOf(request.resource.data) == 'available'
          && !('docOverrideUntil' in request.resource.data)
          && numberReservedFor(vehicleId, request.resource.data.number);
      allow update: if signedIn()
          && ((resource.data.ownerId == request.auth.uid
              && request.resource.data.ownerId == request.auth.uid
              && validVehicle(request.resource.data)
              && !changedKeys().hasAny(['docOverrideUntil'])
              && ownerAvailabilityOk()
              && assignmentOk()
              && (request.resource.data.number == resource.data.number
                  || numberReservedFor(vehicleId, request.resource.data.number)))
            || assignedDriverAvailability()
            || (isAdmin()
              && changedKeys().hasOnly(['availability', 'docOverrideUntil', 'updatedAt'])
              && (!('docOverrideUntil' in request.resource.data) || request.resource.data.docOverrideUntil is timestamp)
              && validVehicle(request.resource.data)));
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // vehicle_expenses/{id}: fuel, toll, repair and service lines the vehicle's
    // owner keeps for their own books (paise). Private to the owner; a wrong
    // line is deleted and entered again.
    match /vehicle_expenses/{expenseId} {
      allow read, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['ownerId', 'vehicleId', 'kind', 'amountPaise', 'note', 'date', 'createdAt'])
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.vehicleId is string
          && get(docPath('vehicles', request.resource.data.vehicleId)).data.ownerId == request.auth.uid
          && request.resource.data.kind in ['fuel', 'toll', 'repair', 'service', 'other']
          && request.resource.data.amountPaise is int && request.resource.data.amountPaise >= 1 && request.resource.data.amountPaise <= 10000000
          && request.resource.data.note is string && request.resource.data.note.size() <= 100
          && request.resource.data.date is timestamp
          && request.resource.data.createdAt == request.time;
      allow update: if false;
    }

    // ------------------------------------------------------------------
    // Driver network. driver_presence/{uid}: where a driver chose to be seen
    // (rounded to about 1 km, for a limited time, or not at all). Drivers who
    // chose "nearby" appear in a geohash list; "connections" is read one
    // driver at a time by connected drivers; "trip" and "hidden" store no
    // position. Expiry is checked on single reads only: a list cannot be
    // filtered by time in rules, so the app hides expired entries
    // (TODO(functions): remove them).
    // ------------------------------------------------------------------
    function linkId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function blockedBy(other) {
      return exists(/databases/$(database)/documents/users/$(other)/blocked/$(request.auth.uid));
    }

    function otherMember(members) {
      return members[0] == request.auth.uid ? members[1] : members[0];
    }

    function linkConnected(a, b) {
      return exists(docPath('driver_links', linkId(a, b)))
          && get(docPath('driver_links', linkId(a, b))).data.status == 'connected';
    }

    function presenceShapeOk(d) {
      return d.name is string && d.name.size() <= 80
          && d.mode in ['nearby', 'connections', 'trip', 'hidden']
          && d.updatedAt == request.time
          && (d.mode in ['nearby', 'connections']
              ? (d.keys().hasOnly(['name', 'mode', 'lat', 'lng', 'geohash', 'sharedUntil', 'updatedAt'])
                  && d.lat is number && d.lat >= -90 && d.lat <= 90
                  && d.lng is number && d.lng >= -180 && d.lng <= 180
                  && d.geohash is string && d.geohash.matches('^[0-9b-hjkmnp-z]{4,12}$')
                  && d.sharedUntil is timestamp && d.sharedUntil > request.time
                  && d.sharedUntil <= request.time + duration.value(24, 'h'))
              : d.keys().hasOnly(['name', 'mode', 'updatedAt']));
    }

    match /driver_presence/{uid} {
      allow get: if isUser(uid)
          || (signedIn() && resource.data.get('sharedUntil', request.time) > request.time
              && (resource.data.mode == 'nearby'
                  || (resource.data.mode == 'connections' && linkConnected(request.auth.uid, uid))));
      allow list: if signedIn() && resource.data.mode == 'nearby';
      allow create, update: if isUser(uid)
          && get(docPath('users', uid)).data.get('role', '') in ['driver', 'fleet']
          && presenceShapeOk(request.resource.data);
      allow delete: if isUser(uid);
    }

    // driver_links/{smallerUid_largerUid}: a connection request, then a
    // connection. Only the other driver accepts; either may end it. Someone
    // who blocked you cannot be asked.
    function messageCardOk(c) {
      return c is map
          && c.keys().hasOnly(['loadId', 'pickup', 'drop', 'cargoType', 'weight', 'vehicleType', 'budgetPaise'])
          && c.loadId is string && c.loadId.size() >= 1 && c.loadId.size() <= 40
          && c.pickup is string && c.pickup.size() >= 1 && c.pickup.size() <= 80
          && c.drop is string && c.drop.size() >= 1 && c.drop.size() <= 80
          && c.cargoType is string && c.cargoType.size() <= 40
          && c.weight is number && c.weight > 0 && c.weight <= 1000
          && c.vehicleType is string && c.vehicleType.size() <= 30
          && (!('budgetPaise' in c) || (c.budgetPaise is int && c.budgetPaise >= 0 && c.budgetPaise <= 10000000000));
    }

    // A chat message of the driver network: text and/or a load card.
    function networkMessageOk(d) {
      return d.keys().hasOnly(['senderId', 'senderName', 'text', 'loadCard', 'flagged', 'createdAt'])
          && d.senderId == request.auth.uid
          && d.senderName is string && d.senderName.size() <= 80
          && d.text is string && d.text.size() <= 500
          && (d.text.size() >= 1 || 'loadCard' in d)
          && (!('loadCard' in d) || messageCardOk(d.loadCard))
          && d.flagged is bool
          && d.createdAt == request.time;
    }

    match /driver_links/{pairId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['members', 'requestedBy', 'requesterName', 'targetName', 'status', 'createdAt', 'updatedAt'])
          && request.resource.data.members is list && request.resource.data.members.size() == 2
          && request.resource.data.members[0] < request.resource.data.members[1]
          && request.auth.uid in request.resource.data.members
          && pairId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
          && request.resource.data.requestedBy == request.auth.uid
          && request.resource.data.requesterName is string && request.resource.data.requesterName.size() <= 80
          && request.resource.data.targetName is string && request.resource.data.targetName.size() <= 80
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && !blockedBy(otherMember(request.resource.data.members));
      allow update: if signedIn()
          && request.auth.uid in resource.data.members
          && resource.data.status == 'pending'
          && resource.data.requestedBy != request.auth.uid
          && changedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status == 'connected'
          && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid in resource.data.members;

      match /messages/{messageId} {
        allow read: if signedIn()
            && request.auth.uid in get(docPath('driver_links', pairId)).data.members
            && get(docPath('driver_links', pairId)).data.status == 'connected';
        allow create: if signedIn()
            && request.auth.uid in get(docPath('driver_links', pairId)).data.members
            && get(docPath('driver_links', pairId)).data.status == 'connected'
            && networkMessageOk(request.resource.data)
            && rateBumped('message', messageId)
            && !blockedBy(otherMember(get(docPath('driver_links', pairId)).data.members));
        allow update, delete: if false;
      }
    }

    // driver_groups/{id}: a trip, route, convoy or fleet group. Created with
    // only the owner; the owner adds connected drivers one at a time and may
    // remove anyone; a member leaves by removing themselves.
    match /driver_groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['name', 'kind', 'ownerId', 'memberIds', 'createdAt', 'updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
          && request.resource.data.kind in ['trip', 'route', 'convoy', 'fleet']
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.memberIds == [request.auth.uid]
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
          && changedKeys().hasOnly(['memberIds', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.memberIds is list
          && request.resource.data.memberIds.size() <= 30
          && ((resource.data.ownerId == request.auth.uid
                && request.auth.uid in request.resource.data.memberIds
                && (resource.data.memberIds.hasAll(request.resource.data.memberIds)
                    || (request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
                        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
                        && linkConnected(request.auth.uid, request.resource.data.memberIds.removeAll(resource.data.memberIds)[0]))))
              || (resource.data.ownerId != request.auth.uid
                  && request.auth.uid in resource.data.memberIds
                  && !(request.auth.uid in request.resource.data.memberIds)
                  && resource.data.memberIds.hasAll(request.resource.data.memberIds)
                  && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1));
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in get(docPath('driver_groups', groupId)).data.memberIds;
        allow create: if signedIn()
            && request.auth.uid in get(docPath('driver_groups', groupId)).data.memberIds
            && networkMessageOk(request.resource.data)
            && rateBumped('message', messageId);
        allow update, delete: if false;
      }
    }

    // identity_index/{sha256(type + number)} = {uid, role, type, createdAt}.
    // One document (licence, PAN, RC, GST) can belong to one account only: the
    // id is derived from the number, so a second create is an update and
    // fails. The profile points at its entries with users.identityHashes
    // (type -> id); an entry can only be created for the hash the profile
    // names in the same batch. The owner may delete an entry only when the
    // profile now names another entry that exists and is theirs (a changed
    // number), or - for the optional GST only - names none. Admins can change
    // or free any entry. get is open to signed-in users so the app can show a
    // clear "already registered" message; list is closed and the id is a
    // hash, so it does not reveal the number.
    // LATER(paid): Cloud Function with an HMAC secret instead of a plain hash.
    function identityHashAfter(type) {
      return getAfter(docPath('users', request.auth.uid)).data.get('identityHashes', {}).get(type, '');
    }

    function ownsIdentityAfter(h) {
      return h is string && h.matches('^[0-9a-f]{64}$')
          && existsAfter(docPath('identity_index', h))
          && getAfter(docPath('identity_index', h)).data.uid == request.auth.uid;
    }

    function identityReplaced(type, hash) {
      let h = identityHashAfter(type);
      return h != hash && (ownsIdentityAfter(h) || (type == 'gst' && h == ''));
    }

    // Entries written before the type field existed: the owner may drop one
    // only while the profile names at least one other entry of theirs.
    function legacyIdentityReplaced(hash) {
      return (identityHashAfter('dl') != hash && ownsIdentityAfter(identityHashAfter('dl')))
          || (identityHashAfter('pan') != hash && ownsIdentityAfter(identityHashAfter('pan')))
          || (identityHashAfter('rc') != hash && ownsIdentityAfter(identityHashAfter('rc')))
          || (identityHashAfter('gst') != hash && ownsIdentityAfter(identityHashAfter('gst')));
    }

    match /identity_index/{hash} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'role', 'type', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role in ['customer', 'driver', 'fleet']
          && request.resource.data.type in ['dl', 'pan', 'rc', 'gst']
          && request.resource.data.role == getAfter(docPath('users', request.auth.uid)).data.get('role', request.resource.data.role)
          && hash.matches('^[0-9a-f]{64}$')
          && identityHashAfter(request.resource.data.type) == hash;
      allow update: if isAdmin();
      allow delete: if isAdmin()
          || (signedIn() && resource.data.uid == request.auth.uid
              && !existsAfter(docPath('users', request.auth.uid)))
          || (signedIn() && resource.data.uid == request.auth.uid
              && (resource.data.get('type', null) == null
                  ? legacyIdentityReplaced(hash)
                  : identityReplaced(resource.data.type, hash)));
    }

    // vehicle_numbers/{number}: {ownerId, vehicleId}. Created next to the
    // vehicle it names; a second create for the same number is an update and
    // is refused. Freed when the vehicle is deleted or renumbered.
    match /vehicle_numbers/{number} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.keys().hasOnly(['ownerId', 'vehicleId', 'createdAt'])
          && getAfter(docPath('vehicles', request.resource.data.vehicleId)).data.ownerId == request.auth.uid
          && getAfter(docPath('vehicles', request.resource.data.vehicleId)).data.number == number;
      allow update: if false;
      allow delete: if signedIn()
          && resource.data.ownerId == request.auth.uid
          && (!existsAfter(docPath('vehicles', resource.data.vehicleId))
              || getAfter(docPath('vehicles', resource.data.vehicleId)).data.number != number);
    }

    // ------------------------------------------------------------------
    // loads: open loads are visible to every signed-in user; the shipper and
    // the matched driver can always see theirs. The shipper owns writes while
    // the load is open; drivers can only match (with a booking) and close
    // (after delivery).
    // ------------------------------------------------------------------
    // A business owner's booker (business_members) may post loads on the
    // company's behalf; the load then carries businessId and the owner reads it.
    function activeBooker(ownerId, memberId) {
      return exists(docPath('business_members', ownerId + '_' + memberId))
          && get(docPath('business_members', ownerId + '_' + memberId)).data.active == true;
    }

    // public (default) | favourites | invite: the last two list the drivers who may accept.
    function validVisibility(d) {
      return !('visibility' in d)
          || (d.visibility == 'public' && !('allowedDriverIds' in d))
          || (d.visibility in ['favourites', 'invite'] && d.get('allowedDriverIds', []) is list
              && d.get('allowedDriverIds', []).size() >= 1 && d.get('allowedDriverIds', []).size() <= 20);
    }

    function validLoad(d) {
      return d.pickup is string && d.pickup.size() > 1 && d.pickup.size() <= 200
          && d.drop is string && d.drop.size() > 1 && d.drop.size() <= 200
          && d.cargoType is string && d.cargoType.size() <= 60
          && d.weight is number && d.weight > 0 && d.weight <= 1000
          && d.vehicleType is string && d.vehicleType.size() <= 40
          && d.notes.size() <= 500
          && (d.get('budget', null) == null || (d.budget is number && d.budget > 0 && d.budget <= 1000000000))
          && d.pickupDate is timestamp
          && (!('estimate' in d) || validEstimate(d.estimate))
          && validStops(d.get('extraPickups', []))
          && validStops(d.get('extraDrops', []))
          && d.get('pickupSlot', 'any') in ['any', 'morning', 'midday', 'afternoon', 'evening']
          && d.get('paymentMode', 'cash') in ['cash', 'upi_direct']
          && validTradeFields(d)
          && validBookingType(d)
          && (!('invitedDriverId' in d) || (d.invitedDriverId is string && d.invitedDriverId.size() >= 1 && d.invitedDriverId.size() <= 60))
          && (!('blockedDriverIds' in d) || (d.blockedDriverIds is list && d.blockedDriverIds.size() <= 50))
          && validVisibility(d)
          && (!('instant' in d) || d.instant is bool)
          && (!('costCenter' in d) || (d.costCenter is string && d.costCenter.size() >= 1 && d.costCenter.size() <= 30))
          && (!('businessId' in d) || (d.businessId is string && (d.businessId == d.shipperId || activeBooker(d.businessId, d.shipperId))))
          && (!('scheduledAt' in d) || d.scheduledAt is timestamp)
          && (!('fragile' in d) || d.fragile is bool)
          && (!('highValue' in d) || d.highValue is bool)
          && validPromoShape(d)
          && d.get('creditsUsedPaise', 0) is int
          && (!('pickupGeohash' in d) || (d.pickupGeohash is string && d.pickupGeohash.matches('^[0-9b-hjkmnp-z]{4,12}$')))
          && !prohibitedText(d.get('notes', ''))
          && !prohibitedText(d.cargoType);
    }

    // freight | rental (4/8/12 hours) | movers (items, floor, lift, packing);
    // 0-4 helpers on any of them. Fields of other types are not allowed.
    function validMovers(m) {
      return m is map && m.keys().hasOnly(['items', 'floor', 'hasLift', 'packing'])
          && m.items is list && m.items.size() >= 1 && m.items.size() <= 30
          && (m.items[0] is map && m.items[0].keys().hasOnly(['name', 'qty'])
              && m.items[0].name is string && m.items[0].name.size() >= 1 && m.items[0].name.size() <= 40
              && m.items[0].qty is int && m.items[0].qty >= 1 && m.items[0].qty <= 99)
          && m.floor is int && m.floor >= 0 && m.floor <= 50
          && m.hasLift is bool && m.packing is bool;
    }

    function validBookingType(d) {
      let t = d.get('bookingType', 'freight');
      return t in ['freight', 'rental', 'movers']
          && d.get('helpers', 0) is int && d.get('helpers', 0) >= 0 && d.get('helpers', 0) <= 4
          && (t == 'rental' ? d.get('rentalHours', 0) in [4, 8, 12] : !('rentalHours' in d))
          && (t == 'movers' ? validMovers(d.get('movers', null)) : !('movers' in d));
    }

    // Import/export details, branch and shipment links (all optional).
    function validTradeFields(d) {
      return (!('containerNumber' in d) || (d.containerNumber is string && d.containerNumber.matches('^[A-Z]{4}[0-9]{7}$')))
          && (!('sealNumber' in d) || (d.sealNumber is string && d.sealNumber.matches('^[A-Za-z0-9-]{1,20}$')))
          && (!('branchId' in d) || (d.branchId is string && d.branchId.size() >= 1 && d.branchId.size() <= 60))
          && (!('shipmentId' in d) || (d.shipmentId is string && d.shipmentId.size() >= 1 && d.shipmentId.size() <= 60))
          && (!('shipmentLeg' in d) || d.shipmentLeg in [1, 2]);
    }

    // At most 2 extra stops per side (3 pickups / 3 drops in total).
    function validStops(l) {
      return l is list && l.size() <= 2
          && (l.size() < 1 || (l[0] is string && l[0].size() > 1 && l[0].size() <= 200))
          && (l.size() < 2 || (l[1] is string && l[1].size() > 1 && l[1].size() <= 200));
    }

    // Prohibited goods. Keep in sync with lib/core/constants/prohibited_cargo.dart.
    function prohibitedText(t) {
      return t is string && t.lower().matches('(.*[^a-z])?(explosives?|dynamite|detonator|gunpowder|firearms?|guns?|pistol|rifle|ammunition|bullets|grenade|narcotics|drugs|ganja|charas|heroin|cocaine|opium|radioactive|ivory|counterfeit|fake currency|wildlife|animal skin|fireworks|crackers|patakhe|human remains)([^a-z].*)?');
    }

    // Client-side fare estimate (integer paise). TODO(functions): compute
    // and sign it server-side; rules can only check the shape.
    function validEstimate(e) {
      return e is map
          && e.total is int && e.total >= 0
          && e.tripFare is int && e.tripFare >= 0 && e.tripFare <= e.total
          && e.distanceKm is int && e.distanceKm >= 0 && e.distanceKm <= 5000
          && e.get('helperCharge', 0) is int && e.get('helperCharge', 0) >= 0
          && e.get('rentalCharge', 0) is int && e.get('rentalCharge', 0) >= 0
          && e.get('itemHandlingCharge', 0) is int && e.get('itemHandlingCharge', 0) >= 0
          && e.get('floorCharge', 0) is int && e.get('floorCharge', 0) >= 0
          && e.get('packingCharge', 0) is int && e.get('packingCharge', 0) >= 0;
    }

    // Shipper edits/cancels a load that nobody has accepted yet.
    function shipperEdit() {
      return resource.data.shipperId == request.auth.uid
          && resource.data.status == 'open'
          && request.resource.data.status in ['open', 'closed']
          // Closing by the shipper is a cancellation and must be flagged.
          && request.resource.data.get('cancelled', false) == (request.resource.data.status == 'closed')
          && (request.resource.data.status == 'open' || cancelCounted())
          && !changedKeys().hasAny(['shipperId', 'driverId', 'bookingId', 'createdAt', 'promo', 'creditsUsedPaise'])
          && validLoad(request.resource.data);
    }

    // Driver accepts: open -> matched, in the same batch that creates the
    // booking (request.resource.data.bookingId) for this driver.
    function driverMatch(loadId) {
      let bookingId = request.resource.data.bookingId;
      let booking = getAfter(docPath('bookings', bookingId));
      return resource.data.status == 'open'
          && resource.data.shipperId != request.auth.uid
          && request.resource.data.status == 'matched'
          && request.resource.data.driverId == request.auth.uid
          && bookingId is string
          && changedKeys().hasOnly(['status', 'driverId', 'bookingId', 'matchedAt', 'reopenedAt'])
          && existsAfter(docPath('bookings', bookingId))
          && booking.data.driverId == request.auth.uid
          && booking.data.loadId == loadId
          && booking.data.status == 'accepted';
    }

    // Driver delivers: matched -> closed, together with booking -> delivered.
    function driverClose() {
      return resource.data.status == 'matched'
          && resource.data.driverId == request.auth.uid
          && request.resource.data.status == 'closed'
          && changedKeys().hasOnly(['status', 'closedAt'])
          && getAfter(docPath('bookings', resource.data.bookingId)).data.status == 'delivered';
    }

    // Driver backs out before pickup: matched -> open, clearing the match,
    // together with booking -> cancelled.
    function driverReopen() {
      return resource.data.status == 'matched'
          && resource.data.driverId == request.auth.uid
          && request.resource.data.status == 'open'
          && !('driverId' in request.resource.data)
          && !('bookingId' in request.resource.data)
          && changedKeys().hasOnly(['status', 'driverId', 'bookingId', 'matchedAt', 'reopenedAt'])
          && getAfter(docPath('bookings', resource.data.bookingId)).data.status == 'cancelled';
    }

    // Admin moves a matched load to another driver, together with the
    // booking (see adminReassignBooking).
    function adminReassignLoad() {
      return isAdmin()
          && resource.data.status == 'matched'
          && changedKeys().hasOnly(['driverId'])
          && request.resource.data.driverId == getAfter(docPath('bookings', resource.data.bookingId)).data.driverId
          && request.resource.data.driverId != resource.data.driverId;
    }

    // Admin backfills pickupGeohash on loads posted before the field existed.
    function adminGeohashBackfill() {
      return isAdmin()
          && !('pickupGeohash' in resource.data)
          && changedKeys().hasOnly(['pickupGeohash'])
          && request.resource.data.pickupGeohash.matches('^[0-9b-hjkmnp-z]{4,12}$');
    }

    // Shipper closes a matched advance-booking load as cancelled, together
    // with the booking being cancelled by the customer.
    function shipperCancelsMatchedScheduled() {
      return resource.data.shipperId == request.auth.uid
          && resource.data.status == 'matched'
          && 'scheduledAt' in resource.data
          && request.resource.data.status == 'closed'
          && request.resource.data.get('cancelled', false) == true
          && changedKeys().hasOnly(['status', 'cancelled', 'cancelledAt'])
          && getAfter(docPath('bookings', resource.data.bookingId)).data.status == 'cancelled'
          && getAfter(docPath('bookings', resource.data.bookingId)).data.get('cancellation', {}).get('by', '') == 'customer';
    }

    // rate_limits/{uid}_{kind}: how many loads, offers (bids) and chat
    // messages a user created in the current hour. Every such create must bump
    // the counter in the same batch (rateBumped); the counter itself only moves
    // up by one inside a window, restarts at 1 when the hour is over (the
    // window start is the server time), and never passes the limit.
    function rateLimitFor(kind) {
      return kind == 'load' ? 30 : (kind == 'offer' ? 60 : 120);
    }

    function validRateCounter(id) {
      let d = request.resource.data;
      let kind = id.split('_')[1];
      let ref = docPath('rate_limits', id);
      return d.keys().hasOnly(['count', 'windowStart', 'last'])
          && d.count is int && d.count >= 1 && d.count <= rateLimitFor(kind)
          && d.windowStart is timestamp
          && d.last is string && d.last.size() >= 1 && d.last.size() <= 150
          && ((!exists(ref) || get(ref).data.windowStart + duration.value(1, 'h') <= request.time)
              ? (d.count == 1 && d.windowStart == request.time)
              : (d.count == get(ref).data.count + 1 && d.windowStart == get(ref).data.windowStart));
    }

    match /rate_limits/{counterId} {
      allow read: if signedIn() && counterId.matches(request.auth.uid + '_(load|offer|message)');
      allow create, update: if signedIn() && counterId.matches(request.auth.uid + '_(load|offer|message)') && validRateCounter(counterId);
      allow delete: if false;
    }

    // The bump names the one document it pays for (`last`), so a single bump
    // cannot cover several creates in one batch.
    function rateBumped(kind, docId) {
      let ref = docPath('rate_limits', request.auth.uid + '_' + kind);
      return getAfter(ref).data.last == docId
          && (getAfter(ref).data.windowStart == request.time
              || getAfter(ref).data.count == get(ref).data.count + 1);
    }

    match /loads/{loadId} {
      allow read: if signedIn()
          && (resource.data.status == 'open'
              || resource.data.shipperId == request.auth.uid
              || resource.data.get('businessId', '') == request.auth.uid
              || resource.data.get('driverId', null) == request.auth.uid
              || isAdmin());
      allow create: if signedIn()
          && request.resource.data.shipperId == request.auth.uid
          && request.resource.data.status == 'open'
          && canTransact(request.auth.uid)
          && rateBumped('load', loadId)
          && !request.resource.data.keys().hasAny(['driverId', 'bookingId'])
          && validLoad(request.resource.data)
          && (!('scheduledAt' in request.resource.data)
              || (request.resource.data.scheduledAt >= request.time + duration.value(30, 'm')
                  && request.resource.data.scheduledAt <= request.time + duration.value(90, 'd')))
          && offersCreateOk(loadId, request.resource.data);
      allow update: if signedIn()
          && (shipperEdit() || driverMatch(loadId) || driverClose() || driverReopen() || adminReassignLoad() || adminGeohashBackfill() || shipperCancelsMatchedScheduled());
      allow delete: if signedIn()
          && resource.data.shipperId == request.auth.uid
          && resource.data.status == 'open';
    }

    // ------------------------------------------------------------------
    // bookings/{bookingId}: only the involved driver and customer can read.
    // Only the driver writes: create when accepting an open load (with their
    // own vehicle), advance status one step at a time, or cancel before
    // pickup (which must reopen the load).
    // ------------------------------------------------------------------
    // accepted -> driver_arriving -> loading -> picked_up (pickup OTP)
    //   -> in_transit -> unloading -> delivered (delivery OTP)
    function nextBookingStatus(s) {
      return {'accepted': 'driver_arriving', 'driver_arriving': 'loading', 'loading': 'picked_up',
              'picked_up': 'in_transit', 'in_transit': 'unloading', 'unloading': 'delivered'}.get(s, 'none');
    }

    function tripOtps(bookingId) {
      return get(/databases/$(database)/documents/bookings/$(bookingId)/secrets/otp).data;
    }

    function validPickupProof(p) {
      return p is map && p.keys().hasOnly(['packages', 'weightTons', 'sealNumber', 'damageNote'])
          && p.packages is int && p.packages > 0 && p.packages <= 100000
          && p.weightTons is number && p.weightTons > 0 && p.weightTons <= 100
          && p.sealNumber is string && p.sealNumber.size() <= 40
          && p.damageNote is string && p.damageNote.size() <= 300;
    }

    function validDeliveryProof(p) {
      return p is map && p.keys().hasOnly(['receiverName', 'receiverPhone', 'damageNote'])
          && p.receiverName is string && p.receiverName.size() >= 2 && p.receiverName.size() <= 60
          && p.receiverPhone is string && p.receiverPhone.matches('^$|^[+]?[0-9]{10,13}$')
          && p.damageNote is string && p.damageNote.size() <= 300;
    }

    // One status step by the assigned driver. Pickup and delivery carry the
    // customer's OTP, which must equal the secret only the customer can read.
    // TODO(functions): rate-limit wrong OTP attempts.
    function driverStep(bookingId) {
      let before = resource.data.status;
      let after = request.resource.data;
      return after.status == nextBookingStatus(before)
          && ((!(after.status in ['picked_up', 'delivered'])
                  && changedKeys().hasOnly(['status', 'timeline', 'updatedAt']))
              || (after.status == 'picked_up'
                  && changedKeys().hasOnly(['status', 'timeline', 'updatedAt', 'pickupOtp', 'pickupProof'])
                  && after.pickupOtp == tripOtps(bookingId).pickupOtp
                  && validPickupProof(after.pickupProof))
              || (after.status == 'delivered'
                  && changedKeys().hasOnly(['status', 'timeline', 'updatedAt', 'deliveryOtp', 'deliveryProof'])
                  && after.deliveryOtp == tripOtps(bookingId).deliveryOtp
                  && validDeliveryProof(after.deliveryProof)));
    }

    // Payment records (no money moves): customer marks paid with the amount,
    // then the driver confirms and writes the two ledger lines in the same
    // batch. LATER(paid): gateway. TODO(functions): commission server-side.
    function customerMarksPaid() {
      let after = request.resource.data;
      return resource.data.status != 'cancelled'
          && resource.data.get('paymentStatus', 'pending') == 'pending'
          && changedKeys().hasOnly(['paymentStatus', 'paidAmountPaise', 'paymentMarkedAt', 'updatedAt'])
          && after.paymentStatus == 'customer_marked_paid'
          && after.paidAmountPaise is int && after.paidAmountPaise > 0 && after.paidAmountPaise <= 100000000
          && after.paymentMarkedAt == request.time;
    }

    function driverConfirmsPayment(bookingId) {
      return resource.data.get('paymentStatus', 'pending') == 'customer_marked_paid'
          && changedKeys().hasOnly(['paymentStatus', 'paymentConfirmedAt', 'updatedAt'])
          && request.resource.data.paymentStatus == 'driver_confirmed'
          && request.resource.data.paymentConfirmedAt == request.time
          && existsAfter(docPath('ledger', bookingId + '_trip_earning'))
          && existsAfter(docPath('ledger', bookingId + '_platform_commission'));
    }

    // Driver reports a breakdown once on an active trip.
    function breakdownReport() {
      let b = request.resource.data.breakdown;
      return resource.data.status in ['accepted', 'driver_arriving', 'loading', 'picked_up', 'in_transit', 'unloading']
          && !('breakdown' in resource.data)
          && changedKeys().hasOnly(['breakdown', 'updatedAt'])
          && b is map && b.keys().hasOnly(['note', 'replacementRequested', 'reportedAt'])
          && b.note is string && b.note.size() <= 300
          && b.replacementRequested is bool
          && b.reportedAt == request.time;
    }

    // After a breakdown with a replacement requested, the driver moves the trip
    // to another vehicle they own or are assigned, one that can carry the load.
    function driverReplacesVehicle() {
      let nv = request.resource.data.get('vehicleId', '');
      let v = get(docPath('vehicles', nv)).data;
      return resource.data.status in ['accepted', 'driver_arriving', 'loading', 'picked_up', 'in_transit']
          && request.resource.data.status == resource.data.status
          && resource.data.get('breakdown', {}).get('replacementRequested', false) == true
          && changedKeys().hasOnly(['vehicleId', 'vehicleNumber', 'replacedVehicleIds', 'updatedAt'])
          && nv is string && nv != resource.data.vehicleId
          && (v.ownerId == request.auth.uid || v.get('assignedDriverId', '') == request.auth.uid)
          && v.get('status', 'active') == 'active'
          && v.capacity >= resource.data.weight
          && request.resource.data.vehicleNumber == v.number
          && request.resource.data.replacedVehicleIds is list && request.resource.data.replacedVehicleIds.size() <= 3
          && resource.data.vehicleId in request.resource.data.replacedVehicleIds;
    }

    // Either party records the e-way bill number (12 digits) or clears it.
    function ewayBillUpdate() {
      return changedKeys().hasOnly(['ewayBillNo', 'updatedAt'])
          && request.resource.data.ewayBillNo is string
          && request.resource.data.ewayBillNo.matches('^$|^[0-9]{12}$');
    }

    // Waiting at the loading / unloading point (record only). Minutes can
    // only grow, by no more than the time the clock was running (+1 minute),
    // and a clock can only be started while loading / unloading.
    function stageClockOk(stage) {
      let before = resource.data.get('detention', {});
      let after = request.resource.data.get('detention', {});
      let startedKey = stage + 'StartedAt';
      let minutesKey = stage + 'Minutes';
      let wasRunning = startedKey in before;
      let isRunning = startedKey in after;
      let grew = after.get(minutesKey, 0) - before.get(minutesKey, 0);
      return after.get(minutesKey, 0) is int && after.get(minutesKey, 0) >= before.get(minutesKey, 0) && after.get(minutesKey, 0) <= 1440
          && (isRunning ? (after[startedKey] == request.time || (wasRunning && after[startedKey] == before[startedKey])) : true)
          && (wasRunning || grew == 0)
          && (!wasRunning || isRunning || grew <= (request.time.toMillis() - before[startedKey].toMillis()) / 60000 + 1)
          && (!isRunning || wasRunning || resource.data.status == stage);
    }

    // GPS evidence and odometer readings, each set once by the driver.
    function evidenceUpdate() {
      let b = resource.data;
      let a = request.resource.data;
      let k = changedKeys();
      return k.hasOnly(['pickupGps', 'pickupGpsAt', 'deliveryGps', 'deliveryGpsAt', 'odometerStart', 'odometerEnd', 'updatedAt'])
          && (!k.hasAny(['pickupGps', 'pickupGpsAt'])
              || (k.hasAll(['pickupGps', 'pickupGpsAt']) && !('pickupGps' in b) && a.pickupGps is latlng
                  && a.pickupGpsAt == request.time && b.status in ['picked_up', 'in_transit', 'unloading', 'delivered']))
          && (!k.hasAny(['deliveryGps', 'deliveryGpsAt'])
              || (k.hasAll(['deliveryGps', 'deliveryGpsAt']) && !('deliveryGps' in b) && a.deliveryGps is latlng
                  && a.deliveryGpsAt == request.time && b.status in ['unloading', 'delivered']))
          && (!k.hasAny(['odometerStart'])
              || (!('odometerStart' in b) && a.odometerStart is int && a.odometerStart >= 0 && a.odometerStart <= 9999999
                  && b.status in ['accepted', 'driver_arriving', 'loading', 'picked_up']))
          && (!k.hasAny(['odometerEnd'])
              || (!('odometerEnd' in b) && a.odometerEnd is int && a.odometerEnd >= b.get('odometerStart', 0) && a.odometerEnd <= 9999999
                  && b.status in ['in_transit', 'unloading', 'delivered']));
    }

    function detentionUpdate() {
      return changedKeys().hasOnly(['detention', 'updatedAt'])
          && resource.data.status in ['loading', 'unloading']
          && request.resource.data.detention is map
          && request.resource.data.detention.keys().hasOnly(['loadingMinutes', 'unloadingMinutes', 'loadingStartedAt', 'unloadingStartedAt'])
          && stageClockOk('loading') && stageClockOk('unloading');
    }

    function validBookingCreate(bookingId) {
      let b = request.resource.data;
      let load = get(docPath('loads', b.loadId)).data;
      let loadAfter = getAfter(docPath('loads', b.loadId)).data;
      return b.keys().hasOnly(['loadId', 'driverId', 'vehicleId', 'customerId', 'status', 'pickup', 'drop', 'cargoType', 'weight',
                               'vehicleType', 'budget', 'fareEstimate', 'offerId', 'agreedFarePaise', 'extraPickups', 'extraDrops',
                               'pickupSlot', 'scheduledAt', 'bookingType', 'helpers', 'rentalHours', 'paymentMode', 'paymentStatus', 'containerNumber', 'sealNumber', 'pickupDate', 'notes',
                               'vehicleNumber', 'driverName', 'driverPhone', 'fleetOwnerId', 'businessId', 'costCenter', 'timeline', 'createdAt', 'updatedAt'])
          && b.timeline.keys().hasOnly(['accepted'])
          && b.driverId == request.auth.uid
          && canTransact(request.auth.uid)
          && b.status == 'accepted'
          && load.status == 'open'
          && load.shipperId != request.auth.uid
          && !(request.auth.uid in load.get('blockedDriverIds', []))
          && (load.get('visibility', 'public') == 'public' || request.auth.uid in load.get('allowedDriverIds', []))
          && b.customerId == load.shipperId
          // Denormalized copy must match the load the customer posted.
          && b.pickup == load.pickup
          && b.drop == load.drop
          && b.weight == load.weight
          && b.get('budget', null) == load.get('budget', null)
          && b.get('fareEstimate', null) == load.get('estimate', {}).get('total', null)
          && b.get('extraPickups', []) == load.get('extraPickups', [])
          && b.get('extraDrops', []) == load.get('extraDrops', [])
          && b.get('paymentMode', 'cash') == load.get('paymentMode', 'cash')
          && b.get('scheduledAt', null) == load.get('scheduledAt', null)
          && b.get('bookingType', 'freight') == load.get('bookingType', 'freight')
          && b.get('helpers', 0) == load.get('helpers', 0)
          && b.get('rentalHours', null) == load.get('rentalHours', null)
          && b.get('containerNumber', null) == load.get('containerNumber', null)
          && b.get('sealNumber', null) == load.get('sealNumber', null)
          && b.get('businessId', null) == load.get('businessId', null)
          && b.get('costCenter', null) == load.get('costCenter', null)
          && b.get('paymentStatus', 'pending') == 'pending'
          && !('paidAmountPaise' in b)
          && loadAfter.status == 'matched'
          && loadAfter.driverId == request.auth.uid
          && loadAfter.bookingId == bookingId
          && offerConfirmOk(bookingId, b)
          && (get(docPath('vehicles', b.vehicleId)).data.ownerId == request.auth.uid
              || get(docPath('vehicles', b.vehicleId)).data.get('assignedDriverId', '') == request.auth.uid)
          && (get(docPath('vehicles', b.vehicleId)).data.ownerId == request.auth.uid
              ? !('fleetOwnerId' in b)
              : b.get('fleetOwnerId', '') == get(docPath('vehicles', b.vehicleId)).data.ownerId)
          && get(docPath('vehicles', b.vehicleId)).data.get('status', 'active') == 'active'
          && availabilityOf(get(docPath('vehicles', b.vehicleId)).data) == 'available'
          && (vehiclePapersClear(get(docPath('vehicles', b.vehicleId)).data) || overrideActive(get(docPath('vehicles', b.vehicleId)).data));
    }

    // A booking from an offer: the driver's own selected offer for this
    // load, at its price, confirmed in the same batch. Without an offer the
    // booking may not claim an agreed fare.
    function offerConfirmOk(bookingId, b) {
      return (!('offerId' in b) && !('agreedFarePaise' in b))
          || (b.offerId == b.loadId + '_' + request.auth.uid
              && get(docPath('offers', b.offerId)).data.status == 'selected'
              && b.agreedFarePaise == get(docPath('offers', b.offerId)).data.pricePaise
              && getAfter(docPath('offers', b.offerId)).data.status == 'confirmed'
              && getAfter(docPath('offers', b.offerId)).data.bookingId == bookingId);
    }

    // Live location: the driver may refresh their position only while on the
    // way to the pickup or in transit, without touching anything else.
    function driverLocationUpdate() {
      return resource.data.status in ['driver_arriving', 'in_transit']
          && request.resource.data.status == resource.data.status
          && changedKeys().hasOnly(['lastKnownLocation', 'locationUpdatedAt'])
          && request.resource.data.lastKnownLocation is latlng;
    }

    // Recorded policy charge for a driver cancellation. No money moves.
    function validCancellation(c) {
      return c == null || (c is map && c.keys().hasOnly(['by', 'chargePaise'])
          && c.by in ['driver', 'customer'] && c.chargePaise is int && c.chargePaise >= 0 && c.chargePaise <= 10000000);
    }

    // Customer cancels an advance booking the driver has not started: the
    // booking is cancelled, with the load closed as cancelled in the same batch.
    function customerCancelsScheduled() {
      return resource.data.status == 'accepted'
          && 'scheduledAt' in resource.data
          && changedKeys().hasOnly(['status', 'timeline', 'updatedAt', 'cancellation'])
          && request.resource.data.status == 'cancelled'
          && request.resource.data.get('cancellation', null) != null
          && request.resource.data.cancellation.by == 'customer'
          && validCancellation(request.resource.data.cancellation)
          && cancelCounted()
          && getAfter(docPath('loads', resource.data.loadId)).data.status == 'closed'
          && getAfter(docPath('loads', resource.data.loadId)).data.get('cancelled', false) == true;
    }

    // Admin reassigns a not-yet-picked-up booking to another driver and
    // vehicle (the driver details are copied from that driver's profile).
    function adminReassignBooking() {
      let a = request.resource.data;
      return isAdmin()
          && resource.data.status in ['accepted', 'driver_arriving', 'loading']
          && changedKeys().hasOnly(['driverId', 'vehicleId', 'vehicleNumber', 'vehicleType', 'driverName', 'driverPhone', 'reassignedAt', 'updatedAt'])
          && a.driverId != resource.data.driverId
          && a.reassignedAt == request.time
          && get(docPath('vehicles', a.vehicleId)).data.ownerId == a.driverId
          && getAfter(docPath('loads', resource.data.loadId)).data.driverId == a.driverId;
    }

    match /bookings/{bookingId} {
      allow read: if signedIn()
          && (resource.data.driverId == request.auth.uid
              || resource.data.customerId == request.auth.uid
              || resource.data.get('fleetOwnerId', '') == request.auth.uid
              || resource.data.get('businessId', '') == request.auth.uid
              || isAdmin());
      allow create: if signedIn() && validBookingCreate(bookingId);
      allow update: if signedIn()
          && (adminReassignBooking() || (resource.data.customerId == request.auth.uid && (ewayBillUpdate() || customerMarksPaid() || customerCancelsScheduled()))
          || (resource.data.driverId == request.auth.uid
          && (driverLocationUpdate()
              || ewayBillUpdate()
              || detentionUpdate()
              || evidenceUpdate()
              || driverConfirmsPayment(bookingId)
              || breakdownReport()
              || driverReplacesVehicle()
              || driverStep(bookingId)
              || (changedKeys().hasOnly(['status', 'timeline', 'updatedAt', 'cancellation'])
                  && resource.data.status in ['accepted', 'driver_arriving']
                  && request.resource.data.status == 'cancelled'
                  && validCancellation(request.resource.data.get('cancellation', null))
                  && request.resource.data.get('cancellation', {'by': 'driver'}).by == 'driver'
                  && cancelCounted()
                  && getAfter(docPath('loads', resource.data.loadId)).data.status == 'open'))));
      allow delete: if false;

      // messages: customer <-> driver chat. Plain text up to 500 chars,
      // stamped with the server time, never edited or deleted. Someone who
      // blocked you does not receive your messages.
      function isParty(b) {
        return request.auth.uid == b.driverId || request.auth.uid == b.customerId;
      }

      match /messages/{messageId} {
        allow read: if signedIn() && isParty(get(docPath('bookings', bookingId)).data);
        allow create: if signedIn()
            && isParty(get(docPath('bookings', bookingId)).data)
            && request.resource.data.keys().hasOnly(['senderId', 'text', 'flagged', 'createdAt'])
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
            && request.resource.data.flagged is bool
            && request.resource.data.createdAt == request.time
            && rateBumped('message', messageId)
            && !exists(/databases/$(database)/documents/users/$(
                   get(docPath('bookings', bookingId)).data.driverId == request.auth.uid
                       ? get(docPath('bookings', bookingId)).data.customerId
                       : get(docPath('bookings', bookingId)).data.driverId)/blocked/$(request.auth.uid));
        allow update, delete: if false;
      }

      // chat_reads/{uid}: when each party last read the chat (unread badge).
      match /chat_reads/{userId} {
        allow read, write: if isUser(userId)
            && isParty(get(docPath('bookings', bookingId)).data)
            && (request.resource == null || request.resource.data.keys().hasOnly(['lastReadAt']));
      }

      // signatures/receiver: the receiver's signature as stroke data, saved
      // once by the driver at unloading / delivery.
      match /signatures/{sigId} {
        allow read: if signedIn() && isParty(get(docPath('bookings', bookingId)).data);
        allow create: if signedIn()
            && sigId == 'receiver'
            && get(docPath('bookings', bookingId)).data.driverId == request.auth.uid
            && get(docPath('bookings', bookingId)).data.status in ['unloading', 'delivered']
            && request.resource.data.keys().hasOnly(['strokes', 'driverId', 'createdAt'])
            && request.resource.data.driverId == request.auth.uid
            && request.resource.data.strokes is list
            && request.resource.data.strokes.size() >= 1 && request.resource.data.strokes.size() <= 30
            && request.resource.data.strokes[0] is map
            && request.resource.data.strokes[0].p is list && request.resource.data.strokes[0].p.size() <= 400
            && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      // cargo_docs: append-only references to cargo documents (a changed
      // document is a new record, so the history is kept).
      match /cargo_docs/{docId} {
        allow read: if signedIn() && isParty(get(docPath('bookings', bookingId)).data);
        allow create: if signedIn()
            && isParty(get(docPath('bookings', bookingId)).data)
            && request.resource.data.keys().hasOnly(['type', 'number', 'note', 'leg', 'addedBy', 'createdAt'])
            && request.resource.data.type in ['invoice', 'packing_list', 'bill_of_lading', 'shipping_bill', 'bill_of_entry', 'certificate', 'eway_bill', 'other']
            && request.resource.data.number is string && request.resource.data.number.size() >= 1 && request.resource.data.number.size() <= 40
            && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 200
            && (!('leg' in request.resource.data) || request.resource.data.leg in [1, 2])
            && request.resource.data.addedBy == request.auth.uid
            && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      // secrets/otp: pickup and delivery codes. Only the customer creates and
      // reads them; nobody can change them afterwards.
      match /secrets/{secretId} {
        allow get: if signedIn() && get(docPath('bookings', bookingId)).data.customerId == request.auth.uid;
        allow create: if signedIn()
            && secretId == 'otp'
            && get(docPath('bookings', bookingId)).data.customerId == request.auth.uid
            && request.resource.data.keys().hasOnly(['pickupOtp', 'deliveryOtp', 'createdAt'])
            && request.resource.data.pickupOtp is string && request.resource.data.pickupOtp.matches('^[0-9]{6}$')
            && request.resource.data.deliveryOtp is string && request.resource.data.deliveryOtp.matches('^[0-9]{6}$');
        allow list, update, delete: if false;
      }
    }

    // ------------------------------------------------------------------
    // offers/{loadId}_{driverId}: a driver's price for an open load. The
    // driver creates/withdraws and accepts a counter; the load's shipper
    // counters once, selects or rejects; the driver confirms a selected
    // offer together with creating the booking. Only these two people read it.
    // ------------------------------------------------------------------
    function offerKeysSame(fields) {
      return changedKeys().hasOnly(fields.concat(['status', 'updatedAt']));
    }

    function validOfferCreate(offerId) {
      let o = request.resource.data;
      let load = get(docPath('loads', o.loadId)).data;
      let vehicle = get(docPath('vehicles', o.vehicleId)).data;
      return offerId == o.loadId + '_' + request.auth.uid
          && o.keys().hasOnly(['loadId', 'driverId', 'customerId', 'pickup', 'drop', 'vehicleId', 'vehicleNumber', 'vehicleType',
                               'driverName', 'pricePaise', 'originalPaise', 'status', 'createdAt', 'updatedAt'])
          && o.driverId == request.auth.uid
          && canTransact(request.auth.uid)
          && rateBumped('offer', offerId)
          && o.status == 'pending'
          && o.pricePaise is int && o.pricePaise > 0 && o.pricePaise <= 100000000
          && o.originalPaise == o.pricePaise
          && load.status == 'open'
          && load.shipperId != request.auth.uid
          && o.customerId == load.shipperId
          && o.get('driverName', '') is string && o.get('driverName', '').size() <= 80
          && o.get('pickup', load.pickup) == load.pickup
          && o.get('drop', load.drop) == load.drop
          && vehicle.ownerId == request.auth.uid
          && vehicle.number == o.vehicleNumber;
    }

    function driverOfferUpdate(offerId) {
      let before = resource.data;
      let after = request.resource.data;
      return before.driverId == request.auth.uid
          && ((before.status in ['pending', 'countered', 'selected'] && after.status == 'withdrawn' && offerKeysSame([]))
              || (before.status == 'countered' && after.status == 'pending'
                  && after.pricePaise == before.counterPaise && offerKeysSame(['pricePaise']))
              || (before.status == 'selected' && after.status == 'confirmed'
                  && offerKeysSame(['bookingId'])
                  && existsAfter(docPath('bookings', after.bookingId))
                  && getAfter(docPath('bookings', after.bookingId)).data.offerId == offerId));
    }

    function customerOfferUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      return before.customerId == request.auth.uid
          && ((before.status == 'pending' && !('counterPaise' in before) && after.status == 'countered'
                  && after.counterPaise is int && after.counterPaise > 0 && after.counterPaise <= 100000000
                  && offerKeysSame(['counterPaise']))
              || (before.status == 'pending' && after.status == 'selected' && offerKeysSame([])
                  && get(docPath('loads', before.loadId)).data.status == 'open')
              || (before.status == 'selected' && after.status == 'pending' && offerKeysSame([]))
              || (before.status in ['pending', 'selected'] && after.status == 'rejected' && offerKeysSame([])));
    }

    match /offers/{offerId} {
      allow read: if signedIn()
          && (resource.data.driverId == request.auth.uid || resource.data.customerId == request.auth.uid);
      allow create: if signedIn() && validOfferCreate(offerId);
      allow update: if signedIn() && (driverOfferUpdate(offerId) || customerOfferUpdate());
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // ledger/{bookingId}_{type}: append-only driver wallet lines, written by
    // the booking's driver together with confirming payment received. The
    // earning equals the amount the customer marked paid; the commission is
    // negative and at most half of it.
    // ------------------------------------------------------------------
    function validLedgerLine(entryId) {
      let e = request.resource.data;
      let b = getAfter(docPath('bookings', e.bookingId)).data;
      return e.keys().hasOnly(['driverId', 'bookingId', 'type', 'amountPaise', 'createdAt'])
          && entryId == e.bookingId + '_' + e.type
          && e.driverId == request.auth.uid
          && b.driverId == request.auth.uid
          && b.paymentStatus == 'driver_confirmed'
          && e.amountPaise is int
          && ((e.type == 'trip_earning' && e.amountPaise == b.paidAmountPaise)
              || (e.type == 'platform_commission' && e.amountPaise <= 0 && e.amountPaise * -2 <= b.paidAmountPaise));
    }

    match /ledger/{entryId} {
      allow read: if signedIn() && (resource.data.driverId == request.auth.uid || isAdmin());
      allow create: if signedIn() && validLedgerLine(entryId);
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // tickets: help desk. Users open tickets (optionally about one of their
    // bookings; disputes must name one), reply, escalate up to level 3 and
    // close. Admins see everything and manage status/priority.
    // ------------------------------------------------------------------
    function isBookingParty(bookingId) {
      let b = get(docPath('bookings', bookingId)).data;
      return b.driverId == request.auth.uid || b.customerId == request.auth.uid;
    }

    function validTicketCreate() {
      let t = request.resource.data;
      return t.keys().hasOnly(['userId', 'category', 'priority', 'status', 'bookingId', 'subject', 'description',
                               'escalationLevel', 'createdAt', 'updatedAt'])
          && t.userId == request.auth.uid
          && t.category in ['booking_issue', 'payment', 'dispute', 'safety', 'account', 'other']
          && t.priority in ['low', 'normal', 'high', 'urgent']
          && t.status == 'open'
          && t.escalationLevel == 0
          && t.subject is string && t.subject.size() >= 3 && t.subject.size() <= 100
          && t.get('description', '') is string && t.get('description', '').size() <= 1000
          && (!('bookingId' in t) || isBookingParty(t.bookingId))
          && (t.category != 'dispute' || 'bookingId' in t);
    }

    function ownerTicketUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      return before.userId == request.auth.uid
          && before.status in ['open', 'in_progress']
          && ((changedKeys().hasOnly(['escalationLevel', 'updatedAt'])
                  && after.escalationLevel == before.escalationLevel + 1 && after.escalationLevel <= 3)
              || (changedKeys().hasOnly(['status', 'updatedAt']) && after.status == 'closed'));
    }

    match /tickets/{ticketId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && validTicketCreate();
      allow update: if signedIn() && (ownerTicketUpdate()
          || (isAdmin()
              && changedKeys().hasOnly(['status', 'priority', 'escalationLevel', 'assignedTo', 'updatedAt'])
              && request.resource.data.status in ['open', 'in_progress', 'resolved', 'closed']
              && request.resource.data.priority in ['low', 'normal', 'high', 'urgent']));
      allow delete: if false;

      match /replies/{replyId} {
        allow read: if signedIn()
            && (get(docPath('tickets', ticketId)).data.userId == request.auth.uid || isAdmin());
        allow create: if signedIn()
            && request.resource.data.keys().hasOnly(['authorId', 'text', 'fromAdmin', 'createdAt'])
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
            && request.resource.data.createdAt == request.time
            && ((request.resource.data.fromAdmin == false
                    && get(docPath('tickets', ticketId)).data.userId == request.auth.uid
                    && get(docPath('tickets', ticketId)).data.status != 'closed')
                || (request.resource.data.fromAdmin == true && isAdmin()));
        allow update, delete: if false;
      }
    }

    // ------------------------------------------------------------------
    // sos_alerts: a user raises an alert (optionally tied to their booking,
    // with a last known position). Admins acknowledge/resolve.
    // ------------------------------------------------------------------
    match /sos_alerts/{alertId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['userId', 'bookingId', 'location', 'status', 'createdAt'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'open'
          && request.resource.data.createdAt == request.time
          && (request.resource.data.get('location', null) == null || request.resource.data.location is latlng)
          && (!('bookingId' in request.resource.data) || isBookingParty(request.resource.data.bookingId));
      allow update: if isAdmin()
          && changedKeys().hasOnly(['status', 'handledBy', 'handledAt', 'adminNote'])
          && request.resource.data.status in ['open', 'acknowledged', 'resolved'];
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // reports: a booking party reports the other one. Reporters see their
    // own reports; admins review them. Nobody edits a report after filing.
    // ------------------------------------------------------------------
    function reportAboutOtherParty(r) {
      let b = get(docPath('bookings', r.bookingId)).data;
      return (b.driverId == request.auth.uid && b.customerId == r.reportedId)
          || (b.customerId == request.auth.uid && b.driverId == r.reportedId);
    }

    match /reports/{reportId} {
      allow read: if signedIn() && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['reporterId', 'reportedId', 'bookingId', 'reason', 'details', 'messageId', 'status', 'createdAt'])
          && request.resource.data.reporterId == request.auth.uid
          && request.resource.data.reportedId != request.auth.uid
          && request.resource.data.reason in ['abuse', 'fraud', 'off_platform', 'other']
          && request.resource.data.details is string && request.resource.data.details.size() <= 300
          && request.resource.data.status == 'open'
          && reportAboutOtherParty(request.resource.data);
      allow update: if isAdmin() && changedKeys().hasOnly(['status', 'resolvedAt', 'resolvedBy', 'adminNote']);
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // audit_events: append-only log of verification, accept, status change,
    // cancel and risk change. Anyone signed in appends their own events;
    // verification and risk_change are admin-only; only admins read.
    // TODO(functions): write from triggers so clients cannot skip or forge.
    // ------------------------------------------------------------------
    match /audit_events/{eventId} {
      allow read: if isAdmin();
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['type', 'actorId', 'targetId', 'bookingId', 'loadId', 'data', 'createdAt'])
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.type in ['verification', 'accept', 'status_change', 'cancel', 'risk_change', 'reassign', 'config_change', 'user_action', 'evidence', 'doc_view']
          && request.resource.data.data is map
          && request.resource.data.createdAt == request.time
          && (!(request.resource.data.type in ['verification', 'risk_change', 'reassign', 'config_change', 'user_action']) || isAdmin())
          && (!(request.resource.data.type in ['evidence', 'doc_view'])
              || (request.resource.data.bookingId is string
                  && request.auth.uid in [get(docPath('bookings', request.resource.data.bookingId)).data.driverId, get(docPath('bookings', request.resource.data.bookingId)).data.customerId]));
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // ratings/{bookingId}_{raterUid}: after delivery, each party rates the
    // other exactly once. Readable by any signed-in user (profile averages).
    // ------------------------------------------------------------------
    function validRating(ratingId) {
      let r = request.resource.data;
      let b = get(docPath('bookings', r.bookingId)).data;
      return ratingId == r.bookingId + '_' + request.auth.uid
          && r.raterId == request.auth.uid
          && b.status == 'delivered'
          && ((b.driverId == request.auth.uid && r.ratedId == b.customerId)
              || (b.customerId == request.auth.uid && r.ratedId == b.driverId))
          && r.stars is int && r.stars >= 1 && r.stars <= 5
          && r.get('comment', '') is string && r.get('comment', '').size() <= 500
          && (!('cats' in r) || (r.cats is map && r.cats.keys().hasOnly(['time', 'behaviour', 'safety'])
              && r.cats.get('time', 3) is int && r.cats.get('time', 3) >= 1 && r.cats.get('time', 3) <= 5
              && r.cats.get('behaviour', 3) is int && r.cats.get('behaviour', 3) >= 1 && r.cats.get('behaviour', 3) <= 5
              && r.cats.get('safety', 3) is int && r.cats.get('safety', 3) >= 1 && r.cats.get('safety', 3) <= 5))
          && r.keys().hasOnly(['bookingId', 'raterId', 'ratedId', 'stars', 'comment', 'cats', 'createdAt']);
    }

    // rating_flags/{ratingId}: written by the rater in the same batch as a
    // rating under 3 stars; only admins read and resolve them.
    // TODO(functions): create the flag server side.
    // invoices/{bookingId}: the GST invoice the driver (transporter) issues
    // after delivery. Numbers run in a series per issuer and financial year:
    // `invoice_series/{uid}_{fy}.next` is bumped in the same batch, so numbers
    // are gapless and cannot repeat. Amounts are a snapshot; the e-way bill
    // fields are record only (nothing is sent to the GST portal).
    // LATER(paid): GSP / e-way bill API.
    match /invoice_series/{seriesId} {
      allow read: if signedIn() && seriesId.matches(request.auth.uid + '_[0-9]{4}-[0-9]{2}');
      allow create: if signedIn() && seriesId.matches(request.auth.uid + '_[0-9]{4}-[0-9]{2}')
          && request.resource.data.keys().hasOnly(['next', 'updatedAt'])
          && request.resource.data.next == 2
          && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && seriesId.matches(request.auth.uid + '_[0-9]{4}-[0-9]{2}')
          && request.resource.data.keys().hasOnly(['next', 'updatedAt'])
          && request.resource.data.next == resource.data.next + 1
          && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    function validInvoice(bookingId) {
      let i = request.resource.data;
      let b = get(docPath('bookings', bookingId)).data;
      let seriesPath = docPath('invoice_series', request.auth.uid + '_' + i.fy);
      let seqNow = exists(seriesPath) ? get(seriesPath).data.next : 1;
      return i.keys().hasOnly(['bookingId', 'issuerId', 'customerId', 'driverId', 'seq', 'fy', 'number', 'gstPercent', 'taxablePaise',
                               'cgstPaise', 'sgstPaise', 'totalPaise', 'sellerName', 'sellerGstin', 'buyerName', 'buyerGstin', 'hsn',
                               'ewayBillNo', 'ewayValidUntil', 'ewayDistanceKm', 'issuedAt'])
          && i.bookingId == bookingId
          && b.status == 'delivered'
          && b.driverId == request.auth.uid && i.issuerId == request.auth.uid
          && i.driverId == b.driverId && i.customerId == b.customerId
          && i.fy is string && i.fy.matches('[0-9]{4}-[0-9]{2}')
          && i.seq is int && i.seq == seqNow && getAfter(seriesPath).data.next == i.seq + 1
          && i.number is string && i.number.matches('LG/[0-9]{4}-[0-9]{2}/[0-9]{5,}')
          && i.number.matches('LG/' + i.fy + '/.*')
          && i.gstPercent is number && i.gstPercent >= 0 && i.gstPercent <= 28
          && i.taxablePaise is int && i.cgstPaise is int && i.sgstPaise is int && i.totalPaise is int
          && i.taxablePaise >= 0 && i.cgstPaise >= 0 && i.sgstPaise >= 0
          && i.totalPaise == i.taxablePaise + i.cgstPaise + i.sgstPaise
          && i.totalPaise > 0 && i.totalPaise <= 1000000000
          && b.get('paidAmountPaise', b.get('agreedFarePaise', b.get('fareEstimate', i.totalPaise))) == i.totalPaise
          && i.sellerName is string && i.sellerName.size() >= 1 && i.sellerName.size() <= 80
          && (!('sellerGstin' in i) || (i.sellerGstin is string && i.sellerGstin.size() == 15))
          && (!('buyerName' in i) || (i.buyerName is string && i.buyerName.size() <= 80))
          && (!('buyerGstin' in i) || (i.buyerGstin is string && i.buyerGstin.size() == 15))
          && i.hsn is string && i.hsn.matches('[0-9]{4,8}')
          && (!('ewayBillNo' in i) || (i.ewayBillNo is string && i.ewayBillNo.matches('[0-9]{12}')))
          && (!('ewayValidUntil' in i) || i.ewayValidUntil is timestamp)
          && (!('ewayDistanceKm' in i) || (i.ewayDistanceKm is int && i.ewayDistanceKm >= 0 && i.ewayDistanceKm <= 5000))
          && i.issuedAt == request.time;
    }

    match /invoices/{bookingId} {
      allow read: if signedIn() && (resource.data.issuerId == request.auth.uid
          || resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if signedIn() && validInvoice(bookingId);
      allow update: if signedIn() && resource.data.issuerId == request.auth.uid
          && changedKeys().hasOnly(['ewayBillNo', 'ewayValidUntil', 'ewayDistanceKm'])
          && (!('ewayBillNo' in request.resource.data) || request.resource.data.ewayBillNo.matches('[0-9]{12}'))
          && (!('ewayValidUntil' in request.resource.data) || request.resource.data.ewayValidUntil is timestamp)
          && (!('ewayDistanceKm' in request.resource.data) || (request.resource.data.ewayDistanceKm is int
              && request.resource.data.ewayDistanceKm >= 0 && request.resource.data.ewayDistanceKm <= 5000));
      allow delete: if false;
    }

    // claims/{bookingId}_{openerUid}: a damage / shortage / delay claim opened
    // by the customer or the driver of a booking that reached unloading.
    // One per party per booking. Both parties and admins read it; only admins
    // change status and resolution (record only: no money moves). The
    // timeline is the append-only `events` subcollection.
    // TODO(functions): notify the other party.
    function claimParty(c) {
      return request.auth.uid == c.customerId || request.auth.uid == c.driverId;
    }

    match /claims/{claimId} {
      allow read: if signedIn() && (claimParty(resource.data) || isAdmin());
      allow create: if signedIn() && validClaim(claimId);
      allow update: if isAdmin()
          && changedKeys().hasOnly(['status', 'outcome', 'awardedPaise', 'resolutionNote', 'resolvedBy', 'resolvedAt', 'updatedAt'])
          && request.resource.data.status in ['under_review', 'resolved']
          && (request.resource.data.status != 'resolved'
              || (request.resource.data.get('outcome', '') in ['upheld', 'partial', 'declined']
                  && request.resource.data.get('resolvedBy', '') == request.auth.uid))
          && (!('awardedPaise' in request.resource.data) || (request.resource.data.awardedPaise is int
              && request.resource.data.awardedPaise >= 0 && request.resource.data.awardedPaise <= 10000000))
          && (!('resolutionNote' in request.resource.data) || (request.resource.data.resolutionNote is string
              && request.resource.data.resolutionNote.size() <= 1000))
          && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /events/{eventId} {
        allow read: if signedIn() && (claimParty(get(docPath('claims', claimId)).data) || isAdmin());
        allow create: if signedIn()
            && request.resource.data.keys().hasOnly(['by', 'role', 'kind', 'text', 'createdAt'])
            && request.resource.data.by == request.auth.uid
            && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
            && request.resource.data.createdAt == request.time
            && ((isAdmin() && request.resource.data.role == 'admin' && request.resource.data.kind in ['message', 'status', 'resolution'])
                || (claimParty(getAfter(docPath('claims', claimId)).data)
                    && request.resource.data.kind in ['opened', 'message']
                    && getAfter(docPath('claims', claimId)).data.status in ['open', 'under_review']
                    && request.resource.data.role == (request.auth.uid == getAfter(docPath('claims', claimId)).data.customerId ? 'customer' : 'driver')));
        allow update, delete: if false;
      }
    }

    function validClaim(claimId) {
      let c = request.resource.data;
      let b = get(docPath('bookings', c.bookingId)).data;
      return claimId == c.bookingId + '_' + request.auth.uid
          && c.keys().hasOnly(['bookingId', 'customerId', 'driverId', 'openedBy', 'type', 'description', 'amountPaise', 'status', 'createdAt', 'updatedAt'])
          && c.openedBy == request.auth.uid
          && c.customerId == b.customerId && c.driverId == b.driverId
          && (c.openedBy == b.customerId || c.openedBy == b.driverId)
          && b.status in ['unloading', 'delivered']
          && c.type in ['damage', 'shortage', 'delay', 'payment', 'behaviour', 'other']
          && c.description is string && c.description.size() >= 10 && c.description.size() <= 1000
          && (!('amountPaise' in c) || (c.amountPaise is int && c.amountPaise >= 0 && c.amountPaise <= 10000000))
          && c.status == 'open'
          && c.createdAt == request.time && c.updatedAt == request.time;
    }

    match /rating_flags/{ratingId} {
      allow read: if isAdmin();
      allow create: if signedIn()
          && ratingId.matches('.*_' + request.auth.uid)
          && request.resource.data.keys().hasOnly(['bookingId', 'raterId', 'ratedId', 'stars', 'status', 'createdAt'])
          && request.resource.data.raterId == request.auth.uid
          && request.resource.data.status == 'open'
          && request.resource.data.stars is int && request.resource.data.stars < 3
          && request.resource.data.createdAt == request.time
          && getAfter(docPath('ratings', ratingId)).data.stars == request.resource.data.stars
          && getAfter(docPath('ratings', ratingId)).data.ratedId == request.resource.data.ratedId
          && getAfter(docPath('ratings', ratingId)).data.bookingId == request.resource.data.bookingId;
      allow update: if isAdmin()
          && changedKeys().hasOnly(['status', 'handledBy', 'handledAt'])
          && request.resource.data.status in ['reviewed', 'dismissed']
          && request.resource.data.handledBy == request.auth.uid
          && request.resource.data.handledAt == request.time;
      allow delete: if false;
    }

    match /ratings/{ratingId} {
      allow read: if signedIn();
      allow create: if signedIn() && validRating(ratingId);
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // config/{docId}: app configuration (vehicle_types, pricing, ...).
    // Every signed-in user reads it; only admins write.
    // ------------------------------------------------------------------
    function validConfig(docId) {
      let d = request.resource.data;
      return (docId == 'vehicle_types'
              && d.keys().hasOnly(['types', 'updatedAt'])
              && d.types is list && d.types.size() > 0 && d.types.size() <= 50)
          || (docId != 'vehicle_types' && d.size() <= 100);
    }

    // admins/{uid}: the admin allowlist. A user may read only their own
    // entry (so the app can show the Admin menu); nobody writes it from a
    // client. Add one by hand in the Firebase Console.
    // deletion_requests/{uid}: a user asks for account deletion (one doc per
    // user, only while none is pending); admins review and mark it done.
    // TODO(functions): perform the deletion with the Admin SDK.
    match /deletion_requests/{uid} {
      allow read: if isUser(uid) || isAdmin();
      allow create: if isUser(uid)
          && request.resource.data.keys().hasOnly(['userId', 'status', 'reason', 'createdAt'])
          && request.resource.data.userId == uid
          && request.resource.data.status == 'pending'
          && request.resource.data.reason is string && request.resource.data.reason.size() <= 300
          && request.resource.data.createdAt == request.time;
      allow update: if isUser(uid)
          && resource.data.status != 'pending'
          && request.resource.data.keys().hasOnly(['userId', 'status', 'reason', 'createdAt'])
          && request.resource.data.status == 'pending'
          && request.resource.data.userId == uid
          && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
          && changedKeys().hasOnly(['status', 'handledBy', 'handledAt'])
          && request.resource.data.status in ['pending', 'done', 'rejected'];
      allow delete: if false;
    }

    match /admins/{uid} {
      allow read: if isUser(uid);
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // Devices: users/{uid}/devices/{deviceId} (the owner's list), device_links
    // (who signed in on which device, for admins) and risk_signals (written
    // when an account appears on a new device). The device id is a random
    // value kept on the phone, not a hardware id.
    // TODO(functions): revoke refresh tokens when a device is revoked.
    // ------------------------------------------------------------------
    match /users/{userId}/devices/{deviceId} {
      allow read: if isUser(userId) || isAdmin();
      allow create, update: if isUser(userId)
          && request.resource.data.keys().hasOnly(['label', 'trusted', 'revoked', 'firstSeenAt', 'lastSeenAt', 'lastLoginAt'])
          && request.resource.data.label is string && request.resource.data.label.size() <= 40
          && request.resource.data.trusted is bool && request.resource.data.revoked is bool
          && deviceId.matches('^[a-z0-9-]{8,40}$');
      allow delete: if isUser(userId);
    }

    match /device_links/{linkId} {
      allow read: if isAdmin();
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['deviceId', 'uid', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && linkId == request.resource.data.deviceId + '_' + request.auth.uid
          && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /risk_signals/{signalId} {
      allow read: if isAdmin();
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'type', 'deviceId', 'amountPaise', 'bookingId', 'note', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.type in ['new_device', 'phone_change', 'high_value', 'random_check', 'gps_mismatch']
          && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && changedKeys().hasOnly(['reviewed', 'reviewedBy', 'reviewedAt']);
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // fraud_cases/{id}: admin-only case management (alert -> evidence ->
    // action -> resolution). Notes are append-only.
    // ------------------------------------------------------------------
    match /fraud_cases/{caseId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['userId', 'summary', 'status', 'reportIds', 'createdBy', 'createdAt', 'updatedAt'])
          && request.resource.data.userId is string && request.resource.data.userId.size() >= 1
          && request.resource.data.summary is string && request.resource.data.summary.size() >= 3 && request.resource.data.summary.size() <= 300
          && request.resource.data.status == 'open'
          && request.resource.data.reportIds is list && request.resource.data.reportIds.size() <= 20
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
          && changedKeys().hasOnly(['status', 'outcome', 'resolvedBy', 'resolvedAt', 'reportIds', 'updatedAt'])
          && request.resource.data.status in ['open', 'investigating', 'resolved', 'dismissed']
          && (!('outcome' in request.resource.data) || request.resource.data.outcome in ['no_action', 'warned', 'restricted', 'suspended'])
          && (!(request.resource.data.status in ['resolved', 'dismissed']) || 'outcome' in request.resource.data);
      allow delete: if false;

      match /notes/{noteId} {
        allow read: if isAdmin();
        allow create: if isAdmin()
            && request.resource.data.keys().hasOnly(['by', 'text', 'createdAt'])
            && request.resource.data.by == request.auth.uid
            && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
            && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // ------------------------------------------------------------------
    // Fleet owners. fleet_invites/{ownerId}_{phoneDigits}: the owner invites a
    // driver by phone number; the driver (matched by the phone number on
    // their sign-in token) accepts or declines. fleet_members/{ownerId}_
    // {driverUid}: created by the driver once an accepted invite exists; either
    // side can end it. Vehicles are then assigned to members (see vehicles).
    // ------------------------------------------------------------------
    function phoneDigits(p) {
      return p.replace('[+]', '');
    }

    match /fleet_invites/{inviteId} {
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid
          || resource.data.phone == request.auth.token.get('phone_number', ''));
      allow create: if signedIn()
          && get(docPath('users', request.auth.uid)).data.get('role', '') == 'fleet'
          && request.resource.data.keys().hasOnly(['ownerId', 'ownerName', 'phone', 'status', 'createdAt'])
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.phone is string && request.resource.data.phone.matches('^[+]91[0-9]{10}$')
          && inviteId == request.auth.uid + '_' + phoneDigits(request.resource.data.phone)
          && request.resource.data.get('ownerName', '') is string && request.resource.data.get('ownerName', '').size() <= 60
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && changedKeys().hasOnly(['status', 'answeredAt'])
          && ((resource.data.ownerId == request.auth.uid
                  && resource.data.status == 'pending' && request.resource.data.status == 'cancelled')
              || (resource.data.phone == request.auth.token.get('phone_number', '')
                  && resource.data.status == 'pending' && request.resource.data.status in ['accepted', 'declined']));
      allow delete: if false;
    }

    match /fleet_members/{memberId} {
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid || resource.data.driverId == request.auth.uid);
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['ownerId', 'ownerName', 'driverId', 'driverName', 'driverPhone', 'active', 'createdAt'])
          && request.resource.data.driverId == request.auth.uid
          && memberId == request.resource.data.ownerId + '_' + request.auth.uid
          && request.resource.data.active == true
          && request.resource.data.createdAt == request.time
          && get(docPath('users', request.auth.uid)).data.get('role', '') == 'driver'
          && getAfter(docPath('fleet_invites', request.resource.data.ownerId + '_' + phoneDigits(request.auth.token.get('phone_number', '')))).data.status == 'accepted'
          && request.resource.data.driverPhone == request.auth.token.get('phone_number', '');
      // Either side ends the membership (active goes true -> false only).
      allow update: if signedIn()
          && (resource.data.ownerId == request.auth.uid || resource.data.driverId == request.auth.uid)
          && changedKeys().hasOnly(['active', 'endedAt'])
          && resource.data.active == true && request.resource.data.active == false;
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Business accounts. A customer with a company profile (the owner) invites
    // team members by phone (same flow as fleet_invites). Members are bookers:
    // loads they post carry businessId = the owner, so the owner sees them and
    // the monthly statement. business_statements/{ownerId}_{yyyy-MM} is the
    // owner's saved record of a month (totals in paise per cost center);
    // it is a record, not an invoice or a payment.
    // ------------------------------------------------------------------
    match /business_invites/{inviteId} {
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid
          || resource.data.phone == request.auth.token.get('phone_number', ''));
      allow create: if signedIn()
          && get(docPath('users', request.auth.uid)).data.get('role', '') == 'customer'
          && request.resource.data.keys().hasOnly(['ownerId', 'ownerName', 'phone', 'status', 'createdAt'])
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.phone is string && request.resource.data.phone.matches('^[+]91[0-9]{10}$')
          && inviteId == request.auth.uid + '_' + phoneDigits(request.resource.data.phone)
          && request.resource.data.get('ownerName', '') is string && request.resource.data.get('ownerName', '').size() <= 100
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && changedKeys().hasOnly(['status', 'answeredAt'])
          && ((resource.data.ownerId == request.auth.uid
                  && resource.data.status == 'pending' && request.resource.data.status == 'cancelled')
              || (resource.data.phone == request.auth.token.get('phone_number', '')
                  && resource.data.status == 'pending' && request.resource.data.status in ['accepted', 'declined']));
      allow delete: if false;
    }

    match /business_members/{memberId} {
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid || resource.data.memberId == request.auth.uid);
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['ownerId', 'ownerName', 'memberId', 'memberName', 'memberPhone', 'role', 'active', 'createdAt'])
          && request.resource.data.memberId == request.auth.uid
          && request.resource.data.ownerId != request.auth.uid
          && memberId == request.resource.data.ownerId + '_' + request.auth.uid
          && request.resource.data.role == 'booker'
          && request.resource.data.active == true
          && request.resource.data.createdAt == request.time
          && get(docPath('users', request.auth.uid)).data.get('role', '') == 'customer'
          && getAfter(docPath('business_invites', request.resource.data.ownerId + '_' + phoneDigits(request.auth.token.get('phone_number', '')))).data.status == 'accepted'
          && request.resource.data.memberPhone == request.auth.token.get('phone_number', '');
      allow update: if signedIn()
          && (resource.data.ownerId == request.auth.uid || resource.data.memberId == request.auth.uid)
          && changedKeys().hasOnly(['active', 'endedAt'])
          && resource.data.active == true && request.resource.data.active == false;
      allow delete: if false;
    }

    match /business_statements/{statementId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create, update: if signedIn()
          && request.resource.data.keys().hasOnly(['ownerId', 'month', 'trips', 'totalPaise', 'byCostCenter', 'createdAt'])
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.month is string && request.resource.data.month.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$')
          && statementId == request.auth.uid + '_' + request.resource.data.month
          && request.resource.data.trips is int && request.resource.data.trips >= 0
          && request.resource.data.totalPaise is int && request.resource.data.totalPaise >= 0
          && request.resource.data.byCostCenter is map && request.resource.data.byCostCenter.size() <= 50
          && request.resource.data.createdAt == request.time;
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Empty-truck board. truck_posts/{id}: a verified driver's free truck
    // (route, date up to 30 days ahead, own active vehicle). truck_requests/
    // {postId}_{customerId}: one request per customer per post; the post's
    // driver answers; the customer can withdraw. Nothing is booked here: an
    // accepted request lets the customer post a load reserved for the driver.
    // ------------------------------------------------------------------
    match /truck_posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['driverId', 'driverName', 'vehicleId', 'vehicleNumber', 'vehicleType', 'capacity',
                                                   'fromCity', 'toCity', 'availableDate', 'note', 'status', 'createdAt'])
          && request.resource.data.driverId == request.auth.uid
          && canTransact(request.auth.uid)
          && get(docPath('users', request.auth.uid)).data.get('verified', false) == true
          && get(docPath('vehicles', request.resource.data.vehicleId)).data.ownerId == request.auth.uid
          && get(docPath('vehicles', request.resource.data.vehicleId)).data.status == 'active'
          && request.resource.data.vehicleNumber == get(docPath('vehicles', request.resource.data.vehicleId)).data.number
          && request.resource.data.vehicleType == get(docPath('vehicles', request.resource.data.vehicleId)).data.type
          && request.resource.data.fromCity is string && request.resource.data.fromCity.size() >= 2 && request.resource.data.fromCity.size() <= 60
          && request.resource.data.toCity is string && request.resource.data.toCity.size() >= 2 && request.resource.data.toCity.size() <= 60
          && request.resource.data.availableDate is timestamp
          && request.resource.data.availableDate <= request.time + duration.value(31, 'd')
          && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 200
          && request.resource.data.status == 'open'
          && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.driverId == request.auth.uid
          && changedKeys().hasOnly(['status', 'closedAt'])
          && request.resource.data.status == 'closed';
      allow delete: if false;
    }

    match /truck_requests/{requestId} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || resource.data.driverId == request.auth.uid || isAdmin());
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['postId', 'driverId', 'customerId', 'customerName', 'pickup', 'drop', 'weight',
                                                   'cargoType', 'vehicleType', 'note', 'status', 'createdAt'])
          && request.resource.data.customerId == request.auth.uid
          && requestId == request.resource.data.postId + '_' + request.auth.uid
          && get(docPath('truck_posts', request.resource.data.postId)).data.status == 'open'
          && get(docPath('truck_posts', request.resource.data.postId)).data.driverId == request.resource.data.driverId
          && request.resource.data.driverId != request.auth.uid
          && canTransact(request.auth.uid)
          && request.resource.data.pickup is string && request.resource.data.pickup.size() >= 2 && request.resource.data.pickup.size() <= 100
          && request.resource.data.drop is string && request.resource.data.drop.size() >= 2 && request.resource.data.drop.size() <= 100
          && request.resource.data.weight is number && request.resource.data.weight > 0 && request.resource.data.weight <= 100
          && request.resource.data.get('cargoType', '') is string && request.resource.data.get('cargoType', '').size() <= 40
          && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 200
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
      // The driver answers a pending request; the customer can withdraw one.
      allow update: if signedIn()
          && resource.data.status == 'pending'
          && ((resource.data.driverId == request.auth.uid
                  && changedKeys().hasOnly(['status', 'answeredAt'])
                  && request.resource.data.status in ['accepted', 'declined'])
              || (resource.data.customerId == request.auth.uid
                  && changedKeys().hasOnly(['status'])
                  && request.resource.data.status == 'withdrawn'));
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // payouts/{id}: a driver asks for money from their wallet. Record only:
    // an admin pays by hand and marks it paid or rejected. The rules cannot
    // sum the ledger, so the balance and the one-open-request limit are
    // checked in the app. TODO(functions): check them on the server.
    // ------------------------------------------------------------------
    match /payouts/{payoutId} {
      allow read: if signedIn() && (resource.data.driverId == request.auth.uid || isAdmin());
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['driverId', 'amountPaise', 'status', 'createdAt'])
          && request.resource.data.driverId == request.auth.uid
          && request.resource.data.status == 'requested'
          && request.resource.data.amountPaise is int
          && request.resource.data.amountPaise >= 100 && request.resource.data.amountPaise <= 100000000
          && request.resource.data.createdAt == request.time
          && canTransact(request.auth.uid);
      allow update: if isAdmin()
          && resource.data.status == 'requested'
          && changedKeys().hasOnly(['status', 'handledBy', 'handledAt'])
          && request.resource.data.status in ['paid', 'rejected']
          && request.resource.data.handledBy == request.auth.uid
          && request.resource.data.handledAt == request.time;
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Driver extras (record only; TODO(functions) to count and settle):
    // tips after delivery, admin-made incentives with once-only claims, and
    // Pro plan requests that an admin answers by hand.
    // ------------------------------------------------------------------
    match /tips/{bookingId} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid
          || resource.data.driverId == request.auth.uid || isAdmin());
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['bookingId', 'customerId', 'driverId', 'amountPaise', 'createdAt'])
          && request.resource.data.bookingId == bookingId
          && request.resource.data.customerId == request.auth.uid
          && get(docPath('bookings', bookingId)).data.customerId == request.auth.uid
          && get(docPath('bookings', bookingId)).data.driverId == request.resource.data.driverId
          && get(docPath('bookings', bookingId)).data.status == 'delivered'
          && request.resource.data.amountPaise is int
          && request.resource.data.amountPaise >= 100 && request.resource.data.amountPaise <= 500000
          && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    function validIncentive() {
      let i = request.resource.data;
      return i.keys().hasOnly(['title', 'targetTrips', 'windowDays', 'bonusPaise', 'startsAt', 'active', 'createdAt', 'updatedAt'])
          && i.title is string && i.title.size() >= 2 && i.title.size() <= 60
          && i.targetTrips is int && i.targetTrips >= 1 && i.targetTrips <= 1000
          && i.windowDays is int && i.windowDays >= 1 && i.windowDays <= 365
          && i.bonusPaise is int && i.bonusPaise >= 1 && i.bonusPaise <= 10000000
          && i.startsAt is timestamp
          && i.active is bool;
    }

    match /incentives/{incentiveId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validIncentive();
      allow delete: if false;
    }

    // incentive_claims/{incentiveId}_{driverId}: one claim per driver per
    // incentive. The rules cannot count trips: an admin checks before paying.
    match /incentive_claims/{claimId} {
      allow read: if signedIn() && (resource.data.driverId == request.auth.uid || isAdmin());
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['incentiveId', 'driverId', 'bonusPaise', 'status', 'createdAt'])
          && request.resource.data.driverId == request.auth.uid
          && claimId == request.resource.data.incentiveId + '_' + request.auth.uid
          && request.resource.data.status == 'claimed'
          && request.resource.data.createdAt == request.time
          && get(docPath('users', request.auth.uid)).data.get('role', 'driver') == 'driver'
          && canTransact(request.auth.uid)
          && get(docPath('incentives', request.resource.data.incentiveId)).data.active == true
          && request.resource.data.bonusPaise == get(docPath('incentives', request.resource.data.incentiveId)).data.bonusPaise
          && request.time >= get(docPath('incentives', request.resource.data.incentiveId)).data.startsAt
          && request.time <= get(docPath('incentives', request.resource.data.incentiveId)).data.startsAt
              + duration.value(get(docPath('incentives', request.resource.data.incentiveId)).data.windowDays + 7, 'd');
      allow update: if isAdmin()
          && changedKeys().hasOnly(['status', 'paidAt'])
          && resource.data.status == 'claimed'
          && request.resource.data.status == 'paid';
      allow delete: if false;
    }

    // plan_requests/{driverUid}: "I would like Pro". The plan itself lives on
    // users/{uid}.plan and only an admin can change it.
    match /plan_requests/{driverUid} {
      allow read: if isUser(driverUid) || isAdmin();
      allow create: if isUser(driverUid)
          && request.resource.data.keys().hasOnly(['uid', 'plan', 'status', 'createdAt'])
          && request.resource.data.uid == driverUid
          && request.resource.data.plan == 'pro'
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
      // The driver can ask again after an answer (the same document, back to pending).
      allow update: if (isUser(driverUid)
              && resource.data.status in ['approved', 'rejected']
              && request.resource.data.keys().hasOnly(['uid', 'plan', 'status', 'createdAt'])
              && request.resource.data.uid == driverUid
              && request.resource.data.plan == 'pro'
              && request.resource.data.status == 'pending'
              && request.resource.data.createdAt == request.time)
          || (isAdmin() && changedKeys().hasOnly(['status', 'answeredAt'])
              && request.resource.data.status in ['approved', 'rejected']);
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Customer offers: promo codes, credits ledger, referrals.
    // All of it is "record only": no money moves and totals are not summed
    // by the server. The rules enforce what they can: promo limits through
    // create-only slot documents, one referral per user, positive credits
    // only from a referral or an admin.
    // TODO(functions): sum balances, expire credits and settle discounts.
    // ------------------------------------------------------------------
    function slotPath(code, n) {
      return /databases/$(database)/documents/promos/$(code)/slots/$(n);
    }

    function usePath(code, id) {
      return /databases/$(database)/documents/promos/$(code)/uses/$(id);
    }

    function creditPath(uid, id) {
      return /databases/$(database)/documents/users/$(uid)/credits/$(id);
    }

    function promoDiscount(p, total) {
      let raw = p.type == 'percent' ? math.floor(total * p.value / 100) : p.value;
      let capped = (p.get('maxDiscountPaise', 0) > 0 && raw > p.maxDiscountPaise) ? p.maxDiscountPaise : raw;
      return capped > total ? total : capped;
    }

    function promoUsable(p) {
      return p.active == true && p.expiresAt > request.time;
    }

    function validPromoDoc(code) {
      let p = request.resource.data;
      return p.keys().hasOnly(['code', 'type', 'value', 'maxDiscountPaise', 'minOrderPaise', 'expiresAt', 'usageLimit',
                               'perUserLimit', 'active', 'createdAt', 'updatedAt'])
          && p.code == code && code.matches('^[A-Z0-9]{3,20}$')
          && p.type in ['percent', 'flat']
          && p.value is int && p.value > 0
          && (p.type == 'flat' || p.value <= 100)
          && (p.type == 'percent' || p.value <= 10000000)
          && p.maxDiscountPaise is int && p.maxDiscountPaise >= 0 && p.maxDiscountPaise <= 10000000
          && p.minOrderPaise is int && p.minOrderPaise >= 0
          && p.expiresAt is timestamp
          && p.usageLimit is int && p.usageLimit >= 1 && p.usageLimit <= 100000
          && p.perUserLimit is int && p.perUserLimit >= 1 && p.perUserLimit <= 100
          && p.active is bool;
    }

    match /promos/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, update: if isAdmin() && validPromoDoc(code);
      allow delete: if false;

      // One document per redemption, numbered 1..usageLimit (no user id, so a
      // signed-in user can probe for a free number). A second create for the
      // same number is an update and fails, so the limit holds even when two
      // people redeem at once.
      match /slots/{n} {
        allow get: if signedIn();
        allow list: if isAdmin();
        allow create: if signedIn()
            && n.matches('^[0-9]{1,6}$') && int(n) >= 1
            && int(n) <= get(docPath('promos', code)).data.usageLimit
            && promoUsable(get(docPath('promos', code)).data)
            && request.resource.data.keys().hasOnly(['loadId', 'createdAt'])
            && getAfter(docPath('loads', request.resource.data.loadId)).data.shipperId == request.auth.uid
            && getAfter(docPath('loads', request.resource.data.loadId)).data.promo.code == code
            && getAfter(docPath('loads', request.resource.data.loadId)).data.promo.slot == int(n);
        allow update, delete: if false;
      }

      // The same, per user: id is uid_1 .. uid_perUserLimit.
      match /uses/{useId} {
        allow get: if signedIn() && useId.matches('^' + request.auth.uid + '_[0-9]+$');
        allow list: if isAdmin();
        allow create: if signedIn()
            && useId.matches('^' + request.auth.uid + '_[0-9]{1,3}$')
            && int(useId.split('_')[1]) >= 1
            && int(useId.split('_')[1]) <= get(docPath('promos', code)).data.perUserLimit
            && request.resource.data.keys().hasOnly(['uid', 'loadId', 'createdAt'])
            && request.resource.data.uid == request.auth.uid
            && getAfter(docPath('loads', request.resource.data.loadId)).data.shipperId == request.auth.uid
            && getAfter(docPath('loads', request.resource.data.loadId)).data.promo.code == code
            && getAfter(docPath('loads', request.resource.data.loadId)).data.promo.use == int(useId.split('_')[1]);
        allow update, delete: if false;
      }
    }

    // The offer on a new load: the code must be usable, the order big enough,
    // the discount exactly what the code gives, and the slot / per-user
    // documents must be created in the same batch.
    function validPromoOnCreate(loadId, d) {
      let pr = d.get('promo', null);
      let p = get(docPath('promos', pr.code)).data;
      return pr.keys().hasOnly(['code', 'discountPaise', 'slot', 'use'])
          && pr.slot is int && pr.use is int
          && 'estimate' in d
          && promoUsable(p)
          && d.estimate.total >= p.minOrderPaise
          && pr.discountPaise is int && pr.discountPaise > 0
          && pr.discountPaise == promoDiscount(p, d.estimate.total)
          && getAfter(slotPath(pr.code, string(pr.slot))).data.loadId == loadId
          && getAfter(usePath(pr.code, d.shipperId + '_' + string(pr.use))).data.loadId == loadId;
    }

    function validCreditsOnCreate(loadId, d) {
      let used = d.get('creditsUsedPaise', 0);
      return used is int && used >= 0
          && (used == 0 || (d.get('estimate', null) != null && used <= d.estimate.total
              && getAfter(creditPath(d.shipperId, 'spend_' + loadId)).data.amountPaise == -used
              && getAfter(creditPath(d.shipperId, 'spend_' + loadId)).data.loadId == loadId));
    }

    function offersCreateOk(loadId, d) {
      return validPromoShape(d) && (!('promo' in d) || validPromoOnCreate(loadId, d)) && validCreditsOnCreate(loadId, d);
    }

    function validPromoShape(d) {
      return !('promo' in d)
          || (d.promo is map && d.promo.code is string && d.promo.code.matches('^[A-Z0-9]{3,20}$'));
    }

    function referralBonus() {
      return exists(docPath('config', 'offers'))
          ? get(docPath('config', 'offers')).data.get('referralBonusPaise', 10000)
          : 10000;
    }

    // users/{uid}/credits/{id}: append-only ledger lines (signed paise).
    // Owner: spend lines tied to their own new load, and the two referral
    // lines of a valid referral. Admin: grants and refunds.
    match /users/{userId}/credits/{lineId} {
      allow read: if isUser(userId) || isAdmin();
      allow create: if signedIn()
          && request.resource.data.amountPaise is int
          && request.resource.data.keys().hasOnly(['amountPaise', 'kind', 'loadId', 'note', 'createdAt'])
          && ((isUser(userId) && request.resource.data.kind == 'spend'
                  && request.resource.data.amountPaise < 0
                  && lineId == 'spend_' + request.resource.data.loadId
                  && getAfter(docPath('loads', request.resource.data.loadId)).data.shipperId == userId
                  && getAfter(docPath('loads', request.resource.data.loadId)).data.get('creditsUsedPaise', 0) == -request.resource.data.amountPaise)
              || (request.resource.data.kind == 'referral'
                  && request.resource.data.amountPaise == referralBonus()
                  && existsAfter(docPath('referrals', request.auth.uid))
                  && ((isUser(userId) && lineId == 'referral_in')
                      || (lineId == 'referral_from_' + request.auth.uid
                          && getAfter(docPath('referrals', request.auth.uid)).data.referrerUid == userId)))
              || (isAdmin() && request.resource.data.kind in ['admin_grant', 'admin_deduct']
                  && request.resource.data.amountPaise != 0
                  && request.resource.data.amountPaise >= -100000000 && request.resource.data.amountPaise <= 100000000
                  && (!('note' in request.resource.data) || request.resource.data.note.size() <= 200)));
      allow update, delete: if false;
    }

    // referral_codes/{CODE} = {uid}: a user's own short code (set once on the
    // profile as users.referralCode).
    match /referral_codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
          && code.matches('^[A-Z0-9]{6,8}$')
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && getAfter(docPath('users', request.auth.uid)).data.referralCode == code;
      allow update, delete: if false;
    }

    // referrals/{refereeUid}: one referral per user, never your own code, only
    // in the first 7 days of the account, and both credit lines in the batch.
    match /referrals/{refereeUid} {
      allow read: if isUser(refereeUid) || isAdmin() || resource.data.referrerUid == request.auth.uid;
      allow create: if isUser(refereeUid)
          && request.resource.data.keys().hasOnly(['referrerUid', 'code', 'createdAt'])
          && request.resource.data.referrerUid != request.auth.uid
          && get(docPath('referral_codes', request.resource.data.code)).data.uid == request.resource.data.referrerUid
          && get(docPath('users', request.auth.uid)).data.get('role', 'customer') == 'customer'
          && get(docPath('users', request.auth.uid)).data.createdAt > request.time - duration.value(7, 'd')
          && existsAfter(creditPath(request.auth.uid, 'referral_in'))
          && existsAfter(creditPath(request.resource.data.referrerUid, 'referral_from_' + request.auth.uid));
      allow update, delete: if false;
    }

    match /config/{docId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validConfig(docId);
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // notifications: in-app messages between the two parties of a booking.
    // Created by one party for the other (same transaction as the event);
    // only the recipient reads them and may only mark them read.
    // ------------------------------------------------------------------
    function validNotification() {
      let n = request.resource.data;
      let b = getAfter(docPath('bookings', n.relatedId)).data;
      return n.keys().hasOnly(['userId', 'type', 'message', 'relatedId', 'status', 'read', 'createdAt'])
          && n.type in ['load_accepted', 'status_changed', 'rating_received', 'booking_cancelled', 'breakdown_reported', 'payment_marked', 'payment_confirmed', 'accident_reported', 'driver_arriving_soon', 'chat_message']
          && n.message is string && n.message.size() <= 200
          && n.read == false
          && n.userId != request.auth.uid
          && request.auth.uid in [b.driverId, b.customerId]
          && n.userId in [b.driverId, b.customerId];
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && validNotification();
      allow update: if signedIn()
          && resource.data.userId == request.auth.uid
          && changedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Anything not matched above is closed (this is Firestore's default; the
    // explicit rule documents it and a test pins it).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
