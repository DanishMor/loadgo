    function customerRecordsAdvance() {
      let a = request.resource.data;
      return resource.data.status in ['accepted', 'driver_arriving', 'loading', 'picked_up', 'in_transit', 'unloading']
          && resource.data.get('paymentStatus', 'pending') == 'pending'
          && !('advancePaise' in resource.data)
          && changedKeys().hasOnly(['advancePaise', 'advanceMarkedAt', 'updatedAt'])
          && a.advancePaise is int && a.advancePaise >= 100 && a.advancePaise <= 100000000
          && a.advancePaise < resource.data.get('agreedFarePaise', resource.data.get('fareEstimate', 100000000))
          && a.advanceMarkedAt == request.time;
