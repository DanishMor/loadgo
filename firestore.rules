          && l.lrNo is string && l.lrNo.size() >= 5 && l.lrNo.size() <= 24
          && l.complianceMode in ['hide', 'show', 'inspection_on_request']
          && l.pickup is string && l.pickup.size() <= 200 && l.drop is string && l.drop.size() <= 200
          && l.goods is string && l.goods.size() <= 120
          && (!('route' in l) || (l.route is string && l.route.size() <= 400))
          && (!('packages' in l) || (l.packages is int && l.packages >= 0 && l.packages <= 100000))
          && (!('weightTons' in l) || ((l.weightTons is int || l.weightTons is float) && l.weightTons >= 0 && l.weightTons <= 1000))
          && (!('vehicleNumber' in l) || (l.vehicleNumber is string && l.vehicleNumber.size() <= 20))
          && (!('driverName' in l) || (l.driverName is string && l.driverName.size() <= 60))
          && (!('consignorName' in l) || (l.consignorName is string && l.consignorName.size() <= 80))
          && (!('consigneeName' in l) || (l.consigneeName is string && l.consigneeName.size() <= 80))
          && (!('issuerName' in l) || (l.issuerName is string && l.issuerName.size() <= 80))
