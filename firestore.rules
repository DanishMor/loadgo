                 && getAfter(docPath('lrs', request.resource.data.issuerId + '_' + string(request.resource.data.year) + '_' + string(request.resource.data.seq) + '_v' + string(request.resource.data.version - 1))).data.status == 'superseded'));
      allow update: if signedIn()
