rules_version = '2';
// LoadGo Firestore security rules.
// Tests: firestore_rules_test/ (run against the emulator, see README there).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isUser(id) {
      return signedIn() && request.auth.uid == id;
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function docPath(collection, id) {
      return /databases/$(database)/documents/$(collection)/$(id);
    }
    function verificationInitOk(d) {
      return d.get('verified', false) == false
          && d.get('verificationStatus', 'pending') == 'pending';
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function adminIn(roles) {
      return isAdmin()
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', 'super') in roles;
    }
    function demoCreate(id) {
      return id.matches('demo_[A-Za-z0-9_]+')
          && request.resource.data.get('demo', false) == true
          && adminIn(['super']);
    }
    function demoDelete(id) {
      return id.matches('demo_[A-Za-z0-9_]+')
          && resource.data.get('demo', false) == true
          && adminIn(['super']);
    }
    function adminVerificationUpdate() {
      return adminIn(['super', 'verifier'])
          && changedKeys().hasOnly(['verified', 'verificationStatus', 'verificationMeta', 'updatedAt'])
          && (!('verificationMeta' in request.resource.data)
              || (request.resource.data.verificationMeta.keys().hasOnly(['source', 'by', 'status', 'at', 'reason', 'note'])
                  && (!('reason' in request.resource.data.verificationMeta)
                      || (request.resource.data.verificationMeta.status == 'rejected'
                          && request.resource.data.verificationMeta.reason in ['docs_unclear', 'name_mismatch', 'licence_expired', 'rc_mismatch', 'other']))
                  && (!('note' in request.resource.data.verificationMeta)
                      || ('reason' in request.resource.data.verificationMeta
                          && request.resource.data.verificationMeta.note is string
                          && request.resource.data.verificationMeta.note.size() <= 120))
                  && request.resource.data.verificationMeta.source == 'manual_review'
                  && request.resource.data.verificationMeta.by == request.auth.uid
                  && request.resource.data.verificationMeta.status == request.resource.data.verificationStatus
                  && request.resource.data.verificationMeta.at == request.time))
          && request.resource.data.verificationStatus in ['pending', 'approved', 'rejected']
          && request.resource.data.verified == (request.resource.data.verificationStatus == 'approved');
    }
    function validProfileText(d) {
      return d.get('name', '') is string && d.get('name', '').size() <= 80
          && d.get('driverName', '') is string && d.get('driverName', '').size() <= 80
          && d.get('email', '') is string && d.get('email', '').size() <= 100
          && d.get('companyName', '') is string && d.get('companyName', '').size() <= 100;
    }
    function validProfileExtras(d) {
      return (!('addresses' in d)
              || (d.addresses is map && d.addresses.keys().hasOnly(['current', 'permanent'])
                  && d.addresses.get('current', '') is string && d.addresses.get('current', '').size() <= 200
                  && d.addresses.get('permanent', '') is string && d.addresses.get('permanent', '').size() <= 200))
          && (!('businessType' in d)
              || d.businessType in ['shipper', 'importer', 'exporter', 'trader', 'transporter'])
          && (!('payoutProfile' in d)
              || (d.payoutProfile is map && d.payoutProfile.keys().hasOnly(['upiId', 'holder'])
                  && d.payoutProfile.get('upiId', '') is string
                  && d.payoutProfile.get('upiId', '').matches('^$|^[a-zA-Z0-9._-]{2,40}@[a-zA-Z]{2,20}$')
                  && d.payoutProfile.get('holder', '') is string && d.payoutProfile.get('holder', '').size() <= 80));
    }
    function validFleetProfile(d) {
      return !('fleet' in d)
          || (d.fleet is map
              && d.fleet.keys().hasOnly(['pan', 'officeCity', 'routes', 'vehicleTypes', 'vehicleCount'])
              && d.fleet.get('pan', '') is string && d.fleet.get('pan', '').size() <= 10
              && d.fleet.get('officeCity', '') is string && d.fleet.get('officeCity', '').size() <= 60
              && d.fleet.get('routes', []) is list && d.fleet.get('routes', []).size() <= 10
              && d.fleet.get('vehicleTypes', []) is list && d.fleet.get('vehicleTypes', []).size() <= 12
              && d.fleet.get('vehicleCount', 0) is int && d.fleet.get('vehicleCount', 0) >= 0 && d.fleet.get('vehicleCount', 0) <= 100000);
    }
    function validEmergencyContacts(d) {
      return !('emergencyContacts' in d)
          || (d.emergencyContacts is list && d.emergencyContacts.size() <= 3);
    }
    function validKyc(d) {
      return (!('driverKyc' in d)
              || (d.driverKyc is map
                  && d.driverKyc.keys().hasOnly(['dlNumber', 'dlExpiry', 'rcNumber', 'aadhaarLast4', 'pan'])
                  && d.driverKyc.get('aadhaarLast4', '').matches('^[0-9]{4}$')
                  && d.driverKyc.get('pan', '').matches('^[A-Z]{5}[0-9]{4}[A-Z]$')
                  && d.driverKyc.get('dlNumber', '') is string && d.driverKyc.get('dlNumber', '').size() >= 8
                  && d.driverKyc.get('rcNumber', '') is string && d.driverKyc.get('rcNumber', '').size() >= 5
                  && d.driverKyc.get('dlExpiry', null) is timestamp))
          && (d.get('kycComplete', false) == false || 'driverKyc' in d);
    }
    function validLastLocation(d) {
      return !('lastLocation' in d)
          || (d.get('consents', {}).get('location', false) == true
              && d.lastLocation is map
              && d.lastLocation.keys().hasOnly(['lat', 'lng', 'geohash', 'updatedAt'])
              && d.lastLocation.lat is number && d.lastLocation.lat >= -90 && d.lastLocation.lat <= 90
              && d.lastLocation.lng is number && d.lastLocation.lng >= -180 && d.lastLocation.lng <= 180
              && d.lastLocation.geohash is string
              && d.lastLocation.geohash.matches('^[0-9b-hjkmnp-z]{4,12}$')
              && d.lastLocation.updatedAt == request.time);
    }
    function validIdentityHashes(d) {
      return !('identityHashes' in d)
          || (d.identityHashes is map
              && d.identityHashes.keys().hasOnly(['dl', 'pan', 'rc', 'gst'])
              && d.identityHashes.get('dl', '0').matches('^[0-9a-f]{64}$|^0$')
              && d.identityHashes.get('pan', '0').matches('^[0-9a-f]{64}$|^0$')
              && d.identityHashes.get('rc', '0').matches('^[0-9a-f]{64}$|^0$')
              && d.identityHashes.get('gst', '0').matches('^[0-9a-f]{64}$|^0$'));
    }
    function referralCodeOk(d) {
      return !('referralCode' in d) || (d.referralCode is string && d.referralCode.matches('^[A-Z0-9]{6,8}$'));
    }
    function referralCodeKept() {
      return !changedKeys().hasAny(['referralCode']) || resource.data.get('referralCode', null) == null;
    }
    function planFieldsAbsent(d) {
      return !d.keys().hasAny(['plan', 'planUntil']);
    }
    function adminPlanUpdate() {
      return adminIn(['super'])
          && changedKeys().hasOnly(['plan', 'planUntil', 'updatedAt'])
          && request.resource.data.get('plan', 'free') in ['free', 'pro']
          && (!('planUntil' in request.resource.data) || request.resource.data.planUntil is timestamp);
    }
    function adminDocOverride() {
      return adminIn(['super', 'verifier'])
          && changedKeys().hasOnly(['docOverrideUntil', 'updatedAt'])
          && request.resource.data.docOverrideUntil is timestamp;
    }
    function reviewMetaAbsent(d) {
      return !('verificationMeta' in d);
    }
    function riskFieldsAbsent(d) {
      return !d.keys().hasAny(['riskTier', 'riskReason', 'riskUpdatedAt', 'reviewFlag']) && d.get('cancelCount', 0) in [0, 1];
    }
    function ownerRiskFieldsUntouched() {
      return !changedKeys().hasAny(['riskTier', 'riskReason', 'riskUpdatedAt', 'reviewFlag'])
          && (!changedKeys().hasAny(['cancelCount'])
              || request.resource.data.cancelCount == resource.data.get('cancelCount', 0) + 1);
    }
    function adminReviewFlagUpdate() {
      let d = request.resource.data;
      return adminIn(['super', 'verifier'])
          && changedKeys().hasOnly(['reviewFlag', 'updatedAt'])
          && (!('reviewFlag' in d)
              || (d.reviewFlag.keys().hasOnly(['kind', 'note', 'by', 'at'])
                  && d.reviewFlag.kind in ['name', 'rc_owner', 'vehicle', 'document', 'other']
                  && d.reviewFlag.note is string && d.reviewFlag.note.size() <= 200
                  && d.reviewFlag.by == request.auth.uid
                  && d.reviewFlag.at == request.time));
    }
    function chatFieldsAbsent(d) {
      return !d.keys().hasAny(['chatStrikes', 'chatSeq', 'chatStrikeAt', 'chatBlockedUntil', 'chatReview']);
    }
    function chatBlockOk(strikes) {
      let a = request.resource.data;
      return strikes < 3
          ? a.get('chatBlockedUntil', null) == resource.data.get('chatBlockedUntil', null)
          : (a.chatBlockedUntil is timestamp
              && a.chatBlockedUntil >= request.time + (strikes == 3 ? duration.value(23, 'h') : (strikes == 4 ? duration.value(71, 'h') : duration.value(167, 'h')))
              && a.chatBlockedUntil <= request.time + duration.value(8, 'd')
              && (strikes < 5 || a.get('chatReview', false) == true));
    }
    function chatViolationStep() {
      let a = request.resource.data;
      let seq = resource.data.get('chatSeq', 0) + 1;
      let strikes = resource.data.get('chatStrikes', 0) + 1;
      return changedKeys().hasOnly(['chatStrikes', 'chatSeq', 'chatStrikeAt', 'chatBlockedUntil', 'chatReview', 'updatedAt'])
          && a.chatSeq == seq
          && a.chatStrikes == strikes
          && a.chatStrikeAt == request.time
          && existsAfter(docPath('violations', request.auth.uid + '_' + string(seq)))
          && chatBlockOk(strikes);
    }
    function chatDecayStep() {
      let a = request.resource.data;
      return changedKeys().hasOnly(['chatStrikes', 'chatStrikeAt', 'updatedAt'])
          && resource.data.get('chatStrikes', 0) > 0
          && a.chatStrikes == resource.data.chatStrikes - 1
          && a.chatStrikeAt == request.time
          && request.time >= resource.data.get('chatStrikeAt', request.time) + duration.value(30, 'd');
    }
    function chatFieldsOk() {
      return !changedKeys().hasAny(['chatStrikes', 'chatSeq', 'chatStrikeAt', 'chatBlockedUntil', 'chatReview'])
          || chatViolationStep() || chatDecayStep();
    }
    function adminChatUpdate() {
      let a = request.resource.data;
      return adminIn(['super', 'support', 'ops'])
          && changedKeys().hasOnly(['chatStrikes', 'chatBlockedUntil', 'chatReview', 'chatStrikeAt', 'updatedAt'])
          && a.get('chatStrikes', 0) is int && a.get('chatStrikes', 0) >= 0 && a.get('chatStrikes', 0) <= 20
          && (!('chatBlockedUntil' in a) || (a.chatBlockedUntil is timestamp && a.chatBlockedUntil <= request.time + duration.value(365, 'd')))
          && a.get('chatReview', false) is bool;
    }
    function adminRiskUpdate() {
      let d = request.resource.data;
      return adminIn(['super', 'ops'])
          && changedKeys().hasOnly(['riskTier', 'riskReason', 'riskUpdatedAt'])
          && d.riskTier in ['normal', 'review', 'restricted', 'suspended', 'banned']
          && d.riskReason is string && d.riskReason.size() <= 200
          && d.riskUpdatedAt == request.time;
    }
    function userMayTransact(u) {
      return u.get('riskTier', 'normal') in ['normal', 'review']
          && (!('driverKyc' in u)
              || u.driverKyc.get('dlExpiry', request.time) > request.time - duration.value(1, 'd')
              || u.get('docOverrideUntil', request.time) > request.time);
    }
    function canTransact(uid) {
      let p = /databases/$(database)/documents/users/$(uid);
      return !exists(p) || userMayTransact(get(p).data);
    }
    function cancelCounted() {
      let ref = /databases/$(database)/documents/users/$(request.auth.uid);
      return getAfter(ref).data.get('cancelCount', 0)
          == (exists(ref) ? get(ref).data.get('cancelCount', 0) : 0) + 1;
    }
    function validBoolMap(d, field, keys) {
      return !(field in d)
          || (d[field] is map && d[field].keys().hasOnly(keys)
              && d[field].get(keys[0], false) is bool && d[field].get(keys[1], false) is bool && d[field].get(keys[2], false) is bool);
    }
    function validBusiness(d) {
      return !('business' in d)
          || (d.business is map && d.business.keys().hasOnly(['legalName', 'gstin', 'address'])
              && d.business.get('legalName', '') is string && d.business.get('legalName', '').size() <= 100
              && d.business.get('address', '') is string && d.business.get('address', '').size() <= 200
              && d.business.get('gstin', '') is string
              && d.business.get('gstin', '').matches('^$|^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$'));
    }
    function validNotificationPrefs(d) {
      return !('notificationPrefs' in d)
          || (d.notificationPrefs is map
              && d.notificationPrefs.keys().hasOnly(['bookingUpdates', 'ratings', 'promotions', 'payments', 'reminders'])
              && d.notificationPrefs.get('bookingUpdates', false) is bool
              && d.notificationPrefs.get('ratings', false) is bool
              && d.notificationPrefs.get('promotions', false) is bool
              && d.notificationPrefs.get('payments', false) is bool
              && d.notificationPrefs.get('reminders', false) is bool);
    }
    function validPrefs(d) {
      return validNotificationPrefs(d)
          && validBoolMap(d, 'consents', ['location', 'analytics', 'marketing']);
    }
    function validRole(r) {
      return r == null || r in ['customer', 'driver', 'fleet'];
    }
    function roleLockOk() {
      let before = resource.data.get('role', null);
      let after = request.resource.data.get('role', null);
      return (before == null ? validRole(after) : after == before
              && request.resource.data.get('selectedRole', before) == before);
    }
    function walletFlag(name) {
      let p = /databases/$(database)/documents/config/features;
      return exists(p) && get(p).data.get('flags', {}).get(name, false) == true;
    }
    function stepUpOk() {
      return !walletFlag('walletStepUp')
          || request.auth.token.get('auth_time', 0) >= request.time.toMillis() / 1000 - 300;
    }
    function payoutChangeOk() {
      return !changedKeys().hasAny(['payoutProfile', 'payoutChangedAt'])
          || (stepUpOk()
              && (!changedKeys().hasAny(['payoutChangedAt'])
                  || (changedKeys().hasAny(['payoutProfile']) && request.resource.data.payoutChangedAt == request.time))
              && (!walletFlag('walletLimits')
                  || !changedKeys().hasAny(['payoutProfile'])
                  || request.resource.data.get('payoutChangedAt', null) == request.time));
    }
    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow create: if isUser(userId) && verificationInitOk(request.resource.data)
          && validKyc(request.resource.data) && validProfileText(request.resource.data) && reviewMetaAbsent(request.resource.data) && planFieldsAbsent(request.resource.data) && !('docOverrideUntil' in request.resource.data) && referralCodeOk(request.resource.data) && validIdentityHashes(request.resource.data) && validLastLocation(request.resource.data) && validRole(request.resource.data.get('role', null))
          && (request.resource.data.get('role', null) == null
              || request.resource.data.get('selectedRole', request.resource.data.role) == request.resource.data.role)
          && validEmergencyContacts(request.resource.data) && validProfileExtras(request.resource.data) && validFleetProfile(request.resource.data) && riskFieldsAbsent(request.resource.data) && chatFieldsAbsent(request.resource.data)
          && validPrefs(request.resource.data) && validBusiness(request.resource.data);
      allow create: if demoCreate(userId);
      allow delete: if demoDelete(userId);
      allow update: if adminVerificationUpdate() || adminChatUpdate() || adminReviewFlagUpdate() || adminRiskUpdate() || adminPlanUpdate() || adminDocOverride() || (isUser(userId)
          && roleLockOk() && validKyc(request.resource.data) && validProfileText(request.resource.data) && !changedKeys().hasAny(['plan', 'planUntil', 'verificationMeta', 'docOverrideUntil']) && referralCodeOk(request.resource.data) && referralCodeKept() && validIdentityHashes(request.resource.data) && validLastLocation(request.resource.data)
          && validEmergencyContacts(request.resource.data) && validProfileExtras(request.resource.data) && validFleetProfile(request.resource.data)
          && validPrefs(request.resource.data) && validBusiness(request.resource.data)
          && ownerRiskFieldsUntouched() && chatFieldsOk() && payoutChangeOk()
          && (!changedKeys().hasAny(['verified', 'verificationStatus'])
              || (resource.data.get('verificationStatus', null) == null
                  && verificationInitOk(request.resource.data))
              || (resource.data.get('verificationStatus', null) == 'rejected'
                  && request.resource.data.verificationStatus == 'pending'
                  && request.resource.data.verified == false)));
      allow delete: if isUser(userId)
          && resource.data.get('riskTier', 'normal') in ['normal', 'review'];
    }
    match /kyc_checks/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /users/{userId}/khata/{partyId} {
      allow read, delete: if isUser(userId);
      allow create, update: if isUser(userId)
          && request.resource.data.keys().hasOnly(['name', 'note', 'balancePaise', 'createdAt', 'updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
          && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 60
          && request.resource.data.balancePaise is int
          && request.resource.data.balancePaise <= 1000000000000 && request.resource.data.balancePaise >= -1000000000000;
      match /entries/{entryId} {
        allow read, delete: if isUser(userId);
        allow create: if isUser(userId)
            && request.resource.data.keys().hasOnly(['kind', 'amountPaise', 'note', 'date', 'createdAt'])
            && request.resource.data.kind in ['owed', 'received']
            && request.resource.data.amountPaise is int
            && request.resource.data.amountPaise >= 1 && request.resource.data.amountPaise <= 100000000000
            && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 60
            && request.resource.data.date is timestamp
            && request.resource.data.createdAt == request.time;
        allow update: if false;
      }
    }
    match /users/{userId}/admin_notes/{noteId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['by', 'text', 'createdAt'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /users/{userId}/blocked/{otherId} {
      allow read, delete: if isUser(userId);
      allow create, update: if isUser(userId) && otherId != userId
          && request.resource.data.keys().hasOnly(['createdAt']);
    }
    match /users/{userId}/saved_places/{placeId} {
      allow read, delete: if isUser(userId);
      allow create, update: if isUser(userId)
          && request.resource.data.keys().hasOnly(['label', 'name', 'address', 'legalName', 'gstin', 'createdAt'])
          && request.resource.data.get('legalName', '') is string && request.resource.data.get('legalName', '').size() <= 80
          && request.resource.data.get('gstin', '') is string
          && request.resource.data.get('gstin', '').matches('^$|^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$')
          && request.resource.data.label in ['home', 'office', 'warehouse', 'factory', 'port', 'cfs']
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
          && request.resource.data.address is string && request.resource.data.address.size() >= 2 && request.resource.data.address.size() <= 200;
    }
    match /users/{userId}/saved_searches/{searchId} {
      allow read, delete: if isUser(userId);
      allow create, update: if isUser(userId)
          && request.resource.data.keys().hasOnly(['kind', 'name', 'filter', 'createdAt'])
          && request.resource.data.kind in ['loads', 'trucks']
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
          && request.resource.data.filter is map && request.resource.data.filter.size() >= 1 && request.resource.data.filter.size() <= 12
          && request.resource.data.filter.keys().hasOnly(['pickup', 'drop', 'from', 'to', 'vehicleType', 'minBudget', 'maxBudget',
                                                         'minWeight', 'maxWeight', 'minCapacity', 'onOrAfter', 'onOrBefore'])
          && request.resource.data.createdAt == request.time;
    }
    match /users/{userId}/load_templates/{templateId} {
      allow read, delete: if isUser(userId);
      allow create, update: if isUser(userId)
          && request.resource.data.keys().hasOnly(['name', 'pickup', 'drop', 'cargoType', 'weight', 'vehicleType', 'budget', 'notes',
                                                   'pickupSlot', 'fragile', 'highValue', 'costCenter', 'createdAt'])
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
          && request.resource.data.pickup is string && request.resource.data.pickup.size() >= 2 && request.resource.data.pickup.size() <= 200
          && request.resource.data.drop is string && request.resource.data.drop.size() >= 2 && request.resource.data.drop.size() <= 200
          && request.resource.data.cargoType is string && request.resource.data.cargoType.size() <= 60
          && request.resource.data.weight is number && request.resource.data.weight > 0 && request.resource.data.weight <= 100
          && request.resource.data.vehicleType is string && request.resource.data.vehicleType.size() <= 40
          && (request.resource.data.get('budget', null) == null || (request.resource.data.budget is number && request.resource.data.budget > 0))
          && request.resource.data.get('notes', '') is string && request.resource.data.get('notes', '').size() <= 300
          && request.resource.data.get('pickupSlot', 'any') in ['any', 'morning', 'midday', 'afternoon', 'evening']
          && request.resource.data.get('fragile', false) is bool
          && request.resource.data.get('highValue', false) is bool
          && request.resource.data.get('costCenter', 'x') is string && request.resource.data.get('costCenter', 'x').size() <= 30
          && request.resource.data.createdAt == request.time;
    }
    match /users/{userId}/recurring_loads/{recurringId} {
      allow read, delete: if isUser(userId);
      allow create, update: if isUser(userId)
          && request.resource.data.keys().hasOnly(['name', 'pickup', 'drop', 'cargoType', 'weight', 'vehicleType', 'budget', 'notes',
                                                   'pickupSlot', 'fragile', 'highValue', 'costCenter', 'frequency', 'nextDueAt', 'active', 'createdAt'])
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
          && request.resource.data.pickup is string && request.resource.data.pickup.size() >= 2 && request.resource.data.pickup.size() <= 200
          && request.resource.data.drop is string && request.resource.data.drop.size() >= 2 && request.resource.data.drop.size() <= 200
          && request.resource.data.cargoType is string && request.resource.data.cargoType.size() <= 60
          && request.resource.data.weight is number && request.resource.data.weight > 0 && request.resource.data.weight <= 1000
          && request.resource.data.vehicleType is string && request.resource.data.vehicleType.size() <= 40
          && (request.resource.data.get('budget', null) == null || (request.resource.data.budget is number && request.resource.data.budget > 0))
          && request.resource.data.get('notes', '') is string && request.resource.data.get('notes', '').size() <= 300
          && request.resource.data.get('pickupSlot', 'any') in ['any', 'morning', 'midday', 'afternoon', 'evening']
          && request.resource.data.get('fragile', false) is bool
          && request.resource.data.get('highValue', false) is bool
          && request.resource.data.get('costCenter', 'x') is string && request.resource.data.get('costCenter', 'x').size() <= 30
          && request.resource.data.frequency in ['weekly', 'monthly']
          && request.resource.data.nextDueAt is timestamp
          && request.resource.data.active is bool;
    }
    match /users/{userId}/favourite_drivers/{driverId} {
      allow read, delete: if isUser(userId);
      allow create, update: if isUser(userId)
          && driverId != userId
