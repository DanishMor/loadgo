      return t.keys().hasOnly(['userId', 'category', 'priority', 'status', 'bookingId', 'businessId', 'subject', 'description',
                               'escalationLevel', 'createdAt', 'updatedAt'])
          && (!('businessId' in t) || (t.businessId is string && (t.businessId == request.auth.uid || activeBooker(t.businessId, request.auth.uid))))
          && t.userId == request.auth.uid
          && t.category in ['booking_issue', 'payment', 'dispute', 'safety', 'account', 'other']
          && t.priority in ['low', 'normal', 'high', 'urgent']
          && t.status == 'open'
          && t.escalationLevel == 0
          && t.subject is string && t.subject.size() >= 3 && t.subject.size() <= 100
          && t.get('description', '') is string && t.get('description', '').size() <= 1000
          && (!('bookingId' in t) || isBookingParty(t.bookingId))
          && (t.category != 'dispute' || 'bookingId' in t);
    }
    function ownerTicketUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      return before.userId == request.auth.uid
          && before.status in ['open', 'in_progress']
          && ((changedKeys().hasOnly(['escalationLevel', 'updatedAt'])
                  && after.escalationLevel == before.escalationLevel + 1 && after.escalationLevel <= 3)
              || (changedKeys().hasOnly(['status', 'updatedAt']) && after.status == 'closed'));
    }
    match /tickets/{ticketId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin()
          || bizActs(resource.data.get('businessId', ''), ['manager', 'accounts']));
      allow create: if signedIn() && validTicketCreate() && rateBumped('ticket', ticketId);
      allow update: if signedIn() && (ownerTicketUpdate()
          || (adminIn(['super', 'support'])
              && changedKeys().hasOnly(['status', 'priority', 'escalationLevel', 'assignedTo', 'updatedAt'])
              && request.resource.data.status in ['open', 'in_progress', 'resolved', 'closed']
              && request.resource.data.priority in ['low', 'normal', 'high', 'urgent']));
      allow delete: if false;
      match /replies/{replyId} {
        allow read: if signedIn()
            && (get(docPath('tickets', ticketId)).data.userId == request.auth.uid || isAdmin()
                || bizActs(get(docPath('tickets', ticketId)).data.get('businessId', ''), ['manager', 'accounts']));
        allow create: if signedIn()
            && request.resource.data.keys().hasOnly(['authorId', 'text', 'fromAdmin', 'createdAt'])
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
            && request.resource.data.createdAt == request.time
            && ((request.resource.data.fromAdmin == false
                    && get(docPath('tickets', ticketId)).data.userId == request.auth.uid
                    && get(docPath('tickets', ticketId)).data.status != 'closed')
                || (request.resource.data.fromAdmin == true && adminIn(['super', 'support'])));
        allow update, delete: if false;
      }
    }
    match /sos_alerts/{alertId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['userId', 'bookingId', 'location', 'status', 'createdAt', 'reason'])
          && request.resource.data.get('reason', 'sos') in ['sos', 'checkin_help', 'checkin_no_answer']
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'open'
          && request.resource.data.createdAt == request.time
          && (request.resource.data.get('location', null) == null || request.resource.data.location is latlng)
          && (!('bookingId' in request.resource.data) || isBookingParty(request.resource.data.bookingId));
      allow update: if adminIn(['super', 'support', 'ops'])
          && changedKeys().hasOnly(['status', 'handledBy', 'handledAt', 'adminNote'])
          && request.resource.data.status in ['open', 'acknowledged', 'resolved'];
      allow delete: if false;
    }
    function bookingParty(b, uid) {
      return uid == b.customerId || uid == b.driverId || uid == b.get('assignedDriverId', '');
    }
    function reportAboutOtherParty(r) {
      let b = get(docPath('bookings', r.bookingId)).data;
      return bookingParty(b, request.auth.uid) && bookingParty(b, r.reportedId);
    }
    function chatAllowed(uid) {
      let p = docPath('users', uid);
      return !exists(p) || get(p).data.get('chatBlockedUntil', request.time) <= request.time;
    }
    function chatTextClean(t) {
      return !t.matches('(?s).*@.*')
          && !t.matches('(?s).*(^|[^0-9])([+]?91[ -]?|0)?[6-9][0-9]{9}([^0-9]|$).*');
    }
    function expireOk(d, maxDays) {
      return !('expireAt' in d)
          || (d.expireAt is timestamp && d.expireAt <= request.time + duration.value(maxDays, 'd'));
    }
    match /assistant_unknown/{id} {
      allow read: if adminIn(['super', 'support']);
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['text', 'userId', 'role', 'language', 'resolved', 'createdAt', 'expireAt'])
          && expireOk(request.resource.data, 240)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 300
          && request.resource.data.role in ['customer', 'driver', 'fleet']
          && request.resource.data.language is string && request.resource.data.language.size() <= 20
          && request.resource.data.resolved == false
          && request.resource.data.createdAt == request.time;
      allow update: if adminIn(['super', 'support'])
          && changedKeys().hasOnly(['resolved', 'resolvedAt', 'resolvedBy'])
          && request.resource.data.resolved == true
          && request.resource.data.resolvedBy == request.auth.uid
          && request.resource.data.resolvedAt == request.time;
      allow delete: if false;
    }
    match /feedback/{id} {
      allow read: if adminIn(['super', 'support']);
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['userId', 'role', 'rating', 'category', 'text', 'appVersion', 'createdAt'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.role in ['customer', 'driver', 'fleet']
          && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && request.resource.data.category in ['app', 'booking', 'payment', 'pricing', 'support', 'idea', 'other']
          && request.resource.data.text is string && request.resource.data.text.size() <= 500
          && request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 20
          && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /trip_shares/{token} {
      allow get: if resource.data.expiresAt > request.time;
      allow list: if signedIn() && isBookingParty(resource.data.bookingId);
      allow create: if signedIn()
          && token.matches('[a-km-z2-9]{24}')
          && request.resource.data.keys().hasOnly(['bookingId', 'ownerId', 'pickup', 'drop', 'status', 'vehicleNumber', 'driverName', 'statusAt', 'expiresAt', 'createdAt'])
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.bookingId is string
          && isBookingParty(request.resource.data.bookingId)
          && request.resource.data.pickup is string && request.resource.data.pickup.size() <= 200
          && request.resource.data.drop is string && request.resource.data.drop.size() <= 200
          && request.resource.data.status is string && request.resource.data.status.size() <= 30
          && request.resource.data.vehicleNumber is string && request.resource.data.vehicleNumber.size() <= 20
          && request.resource.data.driverName is string && request.resource.data.driverName.size() <= 40
          && request.resource.data.statusAt == request.time
          && request.resource.data.createdAt == request.time
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt <= request.time + duration.value(49, 'h');
      allow update: if signedIn()
          && isBookingParty(resource.data.bookingId)
          && resource.data.expiresAt > request.time
          && changedKeys().hasOnly(['status', 'statusAt'])
          && request.resource.data.status is string && request.resource.data.status.size() <= 30
          && request.resource.data.statusAt == request.time;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
    function lrAuditParty(b) {
      let uid = request.auth.uid;
      return uid in [b.customerId, b.driverId, b.get('assignedDriverId', ''), b.get('fleetOwnerId', '')];
    }
    function lrTripDriver(b) {
      let uid = request.auth.uid;
      return uid == b.get('assignedDriverId', '') || (uid == b.driverId && !('fleetOwnerId' in b));
    }
    function lrTripDriverId(b, id) {
      return id == b.get('assignedDriverId', '') || (id == b.driverId && !('fleetOwnerId' in b));
    }
    function lrGrantValid(lrId) {
      let g = /databases/$(database)/documents/lrs/$(lrId)/inspection_grants/$(request.auth.uid);
      return exists(g) && get(g).data.expiresAt > request.time;
    }
    function lrPrivateReader(l) {
      let uid = request.auth.uid;
      return l.issuerId == uid || l.customerId == uid || l.get('fleetOwnerId', '') == uid || isAdmin();
    }
    function lrIssuerOk(l, b) {
      let uid = request.auth.uid;
      return l.issuerId == uid
