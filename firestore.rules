          && request.resource.data.keys().hasOnly(['ownerId', 'vehicleNumber', 'vehicleType', 'vendorName', 'ratePerTripPaise', 'validUntil', 'note', 'addedBy', 'createdAt'])
          && request.resource.data.vehicleNumber is string && request.resource.data.vehicleNumber.size() >= 4 && request.resource.data.vehicleNumber.size() <= 15
          && request.resource.data.vehicleType is string && request.resource.data.vehicleType.size() <= 40
          && request.resource.data.vendorName is string && request.resource.data.vendorName.size() >= 2 && request.resource.data.vendorName.size() <= 80
          && (!('ratePerTripPaise' in request.resource.data) || (request.resource.data.ratePerTripPaise is int && request.resource.data.ratePerTripPaise >= 0 && request.resource.data.ratePerTripPaise <= 1000000000))
          && (!('validUntil' in request.resource.data) || request.resource.data.validUntil is timestamp)
          && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 200
          && request.resource.data.addedBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if bizActs(resource.data.ownerId, ['manager']);
    }
    match /business_pool/{poolId} {
      allow read: if bizReads(resource.data.ownerId);
      allow create: if signedIn()
          && bizActs(request.resource.data.ownerId, ['manager', 'dispatch'])
          && request.resource.data.keys().hasOnly(['ownerId', 'driverId', 'driverName', 'vehicleNumber', 'addedBy', 'createdAt'])
          && poolId == request.resource.data.ownerId + '_' + request.resource.data.driverId
          && request.resource.data.driverName is string && request.resource.data.driverName.size() <= 80
          && request.resource.data.get('vehicleNumber', '') is string && request.resource.data.get('vehicleNumber', '').size() <= 15
          && request.resource.data.addedBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if bizActs(resource.data.ownerId, ['manager', 'dispatch']);
    }
    match /business_expenses/{expenseId} {
      allow read: if bizActs(resource.data.ownerId, ['manager', 'accounts', 'viewer']);
      allow create: if signedIn()
          && bizActs(request.resource.data.ownerId, ['manager', 'accounts'])
          && request.resource.data.keys().hasOnly(['ownerId', 'kind', 'amountPaise', 'date', 'costCenter', 'note', 'addedBy', 'createdAt'])
          && request.resource.data.kind in ['fuel', 'toll', 'loading', 'detention', 'other']
          && request.resource.data.amountPaise is int && request.resource.data.amountPaise >= 1 && request.resource.data.amountPaise <= 10000000000
          && request.resource.data.date is timestamp
          && request.resource.data.get('costCenter', '') is string && request.resource.data.get('costCenter', '').size() <= 30
          && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 100
          && request.resource.data.addedBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
      allow update: if false;
