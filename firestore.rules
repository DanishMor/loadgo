          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.copyType in ['full', 'driver', 'consignee', 'verify']
          && request.resource.data.lrId is string
          && get(docPath('lrs', request.resource.data.lrId)).data.issuerId == request.auth.uid
          && get(docPath('lrs', request.resource.data.lrId)).data.bookingId == request.resource.data.bookingId
          && lrShareFieldsOk(request.resource.data)
          && request.resource.data.status is string && request.resource.data.status.size() <= 20
          && request.resource.data.statusAt == request.time
          && request.resource.data.revoked == false
          && request.resource.data.views == 0
          && request.resource.data.createdAt == request.time
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt <= request.time + duration.value(400, 'd');
      allow update: if (resource.data.expiresAt > request.time && resource.data.revoked == false
                        && changedKeys().hasOnly(['views'])
                        && request.resource.data.views == resource.data.views + 1)
          || (isUser(resource.data.ownerId)
