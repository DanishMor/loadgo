      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['userId', 'bookingId', 'kind', 'excerpt', 'createdAt'])
          && request.resource.data.userId == request.auth.uid
          && violationId == request.auth.uid + '_' + string(getAfter(docPath('users', request.auth.uid)).data.get('chatSeq', 0))
          && request.resource.data.kind in ['phone', 'upi', 'app', 'payment', 'asked_number', 'sent_number']
          && request.resource.data.excerpt is string && request.resource.data.excerpt.size() <= 120
          && request.resource.data.bookingId is string
          && bookingParty(get(docPath('bookings', request.resource.data.bookingId)).data, request.auth.uid)
          && request.resource.data.createdAt == request.time
          && getAfter(docPath('users', request.auth.uid)).data.get('chatStrikes', 0)
