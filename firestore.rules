    match /invoice_series/{seriesId} {
      allow read: if signedIn() && seriesId.matches(request.auth.uid + '_[0-9]{4}-[0-9]{2}');
      allow create: if signedIn() && seriesId.matches(request.auth.uid + '_[0-9]{4}-[0-9]{2}')
          && request.resource.data.keys().hasOnly(['next', 'updatedAt'])
          && request.resource.data.next == 2
          && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && seriesId.matches(request.auth.uid + '_[0-9]{4}-[0-9]{2}')
          && request.resource.data.keys().hasOnly(['next', 'updatedAt'])
          && request.resource.data.next == resource.data.next + 1
          && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    function validInvoice(bookingId) {
      let i = request.resource.data;
      let b = get(docPath('bookings', bookingId)).data;
      let seriesPath = docPath('invoice_series', request.auth.uid + '_' + i.fy);
      let seqNow = exists(seriesPath) ? get(seriesPath).data.next : 1;
      return i.keys().hasOnly(['bookingId', 'issuerId', 'customerId', 'driverId', 'seq', 'fy', 'number', 'gstPercent', 'taxablePaise',
                               'cgstPaise', 'sgstPaise', 'totalPaise', 'sellerName', 'sellerGstin', 'buyerName', 'buyerGstin', 'hsn',
                               'ewayBillNo', 'ewayValidUntil', 'ewayDistanceKm', 'issuedAt'])
          && i.bookingId == bookingId
          && b.status == 'delivered'
          && b.driverId == request.auth.uid && i.issuerId == request.auth.uid
          && i.driverId == b.driverId && i.customerId == b.customerId
          && i.fy is string && i.fy.matches('[0-9]{4}-[0-9]{2}')
          && i.seq is int && i.seq == seqNow && getAfter(seriesPath).data.next == i.seq + 1
          && i.number is string && i.number.matches('LG/[0-9]{4}-[0-9]{2}/[0-9]{5,}')
          && i.number.matches('LG/' + i.fy + '/.*')
          && i.gstPercent is number && i.gstPercent >= 0 && i.gstPercent <= 28
          && i.taxablePaise is int && i.cgstPaise is int && i.sgstPaise is int && i.totalPaise is int
          && i.taxablePaise >= 0 && i.cgstPaise >= 0 && i.sgstPaise >= 0
          && i.totalPaise == i.taxablePaise + i.cgstPaise + i.sgstPaise
          && i.totalPaise > 0 && i.totalPaise <= 1000000000
          && b.get('paidAmountPaise', b.get('agreedFarePaise', b.get('fareEstimate', i.totalPaise))) == i.totalPaise
          && i.sellerName is string && i.sellerName.size() >= 1 && i.sellerName.size() <= 80
          && (!('sellerGstin' in i) || (i.sellerGstin is string && i.sellerGstin.size() == 15))
          && (!('buyerName' in i) || (i.buyerName is string && i.buyerName.size() <= 80))
          && (!('buyerGstin' in i) || (i.buyerGstin is string && i.buyerGstin.size() == 15))
          && i.hsn is string && i.hsn.matches('[0-9]{4,8}')
          && (!('ewayBillNo' in i) || (i.ewayBillNo is string && i.ewayBillNo.matches('[0-9]{12}')))
          && (!('ewayValidUntil' in i) || i.ewayValidUntil is timestamp)
          && (!('ewayDistanceKm' in i) || (i.ewayDistanceKm is int && i.ewayDistanceKm >= 0 && i.ewayDistanceKm <= 5000))
          && i.issuedAt == request.time;
