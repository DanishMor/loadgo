          && request.resource.data.status == 'open'
          && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.driverId == request.auth.uid
          && changedKeys().hasOnly(['status', 'closedAt'])
          && request.resource.data.status == 'closed';
      allow delete: if false;
    }
    match /truck_requests/{requestId} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || resource.data.driverId == request.auth.uid || isAdmin());
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['postId', 'driverId', 'customerId', 'customerName', 'pickup', 'drop', 'weight',
                                                   'cargoType', 'vehicleType', 'note', 'status', 'createdAt'])
          && request.resource.data.customerId == request.auth.uid
          && requestId == request.resource.data.postId + '_' + request.auth.uid
          && get(docPath('truck_posts', request.resource.data.postId)).data.status == 'open'
          && get(docPath('truck_posts', request.resource.data.postId)).data.driverId == request.resource.data.driverId
          && request.resource.data.driverId != request.auth.uid
          && canTransact(request.auth.uid)
          && request.resource.data.pickup is string && request.resource.data.pickup.size() >= 2 && request.resource.data.pickup.size() <= 100
          && request.resource.data.drop is string && request.resource.data.drop.size() >= 2 && request.resource.data.drop.size() <= 100
          && request.resource.data.weight is number && request.resource.data.weight > 0 && request.resource.data.weight <= 100
          && request.resource.data.get('cargoType', '') is string && request.resource.data.get('cargoType', '').size() <= 40
          && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 200
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
          && resource.data.status == 'pending'
          && ((resource.data.driverId == request.auth.uid
                  && changedKeys().hasOnly(['status', 'answeredAt'])
                  && request.resource.data.status in ['accepted', 'declined'])
              || (resource.data.customerId == request.auth.uid
                  && changedKeys().hasOnly(['status'])
                  && request.resource.data.status == 'withdrawn'));
      allow delete: if false;
    }
    function walletFrozen(uid) {
      let p = /databases/$(database)/documents/wallet_freezes/$(uid);
      return exists(p) && get(p).data.get('frozen', false) == true;
    }
    function makerCheckerOn() {
      let p = /databases/$(database)/documents/config/features;
      return exists(p) && get(p).data.get('flags', {}).get('walletMakerChecker', false) == true;
    }
    function summaryAllows(uid, amount) {
      let p = /databases/$(database)/documents/wallets/$(uid);
      return !exists(p) || !(get(p).data.get('availablePaise', null) is int) || amount <= get(p).data.availablePaise;
    }
    function payoutDay() {
      return request.time.year() * 10000 + request.time.month() * 100 + request.time.day();
    }
    function payoutLimitsOk(payoutId) {
      let cfgP = /databases/$(database)/documents/config/wallet;
      let cfg = exists(cfgP) ? get(cfgP).data : {};
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let changed = u.get('payoutChangedAt', null);
      let cp = /databases/$(database)/documents/payout_counters/$(request.auth.uid + '_' + string(payoutDay()));
      return !walletFlag('walletLimits')
          || ((changed == null || changed + duration.value(cfg.get('coolingHours', 24), 'h') <= request.time)
              && existsAfter(cp)
              && getAfter(cp).data.lastPayoutId == payoutId
              && getAfter(cp).data.totalPaise <= cfg.get('dailyLimitPaise', 5000000)
              && getAfter(cp).data.count <= cfg.get('maxPerDay', 3));
    }
    match /payout_counters/{counterId} {
      function counterKeys(t) {
        return t.keys().hasOnly(['count', 'totalPaise', 'lastPayoutId', 'updatedAt'])
            && t.count is int && t.totalPaise is int && t.lastPayoutId is string && t.updatedAt == request.time
            && counterId == request.auth.uid + '_' + string(payoutDay())
            && !exists(/databases/$(database)/documents/payouts/$(t.lastPayoutId))
            && existsAfter(/databases/$(database)/documents/payouts/$(t.lastPayoutId))
            && getAfter(/databases/$(database)/documents/payouts/$(t.lastPayoutId)).data.driverId == request.auth.uid;
      }
      allow read: if signedIn() && (counterId.matches(request.auth.uid + '_[0-9]{8}') || isAdmin());
      allow create: if signedIn() && counterKeys(request.resource.data)
          && request.resource.data.count == 1
          && request.resource.data.totalPaise == getAfter(/databases/$(database)/documents/payouts/$(request.resource.data.lastPayoutId)).data.amountPaise;
      allow update: if signedIn() && counterKeys(request.resource.data)
          && request.resource.data.count == resource.data.count + 1
          && request.resource.data.totalPaise == resource.data.totalPaise + getAfter(/databases/$(database)/documents/payouts/$(request.resource.data.lastPayoutId)).data.amountPaise;
      allow delete: if false;
    }
    match /payouts/{payoutId} {
      allow read: if signedIn() && (resource.data.driverId == request.auth.uid || isAdmin());
      allow create: if signedIn()
          && stepUpOk()
          && payoutLimitsOk(payoutId)
          && !walletFrozen(request.auth.uid)
          && summaryAllows(request.auth.uid, request.resource.data.get('amountPaise', 0))
          && request.resource.data.keys().hasOnly(['driverId', 'amountPaise', 'status', 'createdAt'])
          && request.resource.data.driverId == request.auth.uid
          && request.resource.data.status == 'requested'
          && request.resource.data.amountPaise is int
          && request.resource.data.amountPaise >= 100 && request.resource.data.amountPaise <= 100000000
          && request.resource.data.createdAt == request.time
          && canTransact(request.auth.uid);
      allow update: if adminIn(['super', 'finance'])
          && (
              (!makerCheckerOn()
                  && resource.data.status == 'requested'
                  && changedKeys().hasOnly(['status', 'handledBy', 'handledAt'])
                  && request.resource.data.status in ['paid', 'rejected']
                  && request.resource.data.handledBy == request.auth.uid
                  && request.resource.data.handledAt == request.time)
              || (resource.data.status == 'requested'
                  && changedKeys().hasOnly(['status', 'approvedBy', 'approvedAt'])
                  && request.resource.data.status == 'approved'
                  && request.resource.data.approvedBy == request.auth.uid
                  && request.resource.data.approvedAt == request.time)
              || (resource.data.status == 'approved'
                  && resource.data.get('approvedBy', request.auth.uid) != request.auth.uid
                  && changedKeys().hasOnly(['status', 'paidBy', 'paidAt', 'reference'])
                  && request.resource.data.status == 'paid'
                  && request.resource.data.paidBy == request.auth.uid
                  && request.resource.data.paidAt == request.time
                  && request.resource.data.reference is string
                  && request.resource.data.reference.size() >= 4 && request.resource.data.reference.size() <= 60)
              || (resource.data.status in ['requested', 'approved']
                  && changedKeys().hasOnly(['status', 'handledBy', 'handledAt', 'reason'])
                  && request.resource.data.status == 'rejected'
                  && request.resource.data.handledBy == request.auth.uid
                  && request.resource.data.handledAt == request.time
                  && request.resource.data.reason is string
                  && request.resource.data.reason.size() >= 3 && request.resource.data.reason.size() <= 200)
              || (resource.data.status == 'paid'
                  && changedKeys().hasOnly(['status', 'reversedBy', 'reversedAt', 'reason'])
                  && request.resource.data.status == 'reversed'
                  && request.resource.data.reversedBy == request.auth.uid
                  && request.resource.data.reversedAt == request.time
                  && request.resource.data.reason is string
                  && request.resource.data.reason.size() >= 5 && request.resource.data.reason.size() <= 200)
          );
      allow delete: if false;
    }
    match /tips/{bookingId} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid
          || resource.data.driverId == request.auth.uid || isAdmin());
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['bookingId', 'customerId', 'driverId', 'amountPaise', 'createdAt'])
          && request.resource.data.bookingId == bookingId
          && request.resource.data.customerId == request.auth.uid
          && get(docPath('bookings', bookingId)).data.customerId == request.auth.uid
          && get(docPath('bookings', bookingId)).data.driverId == request.resource.data.driverId
          && get(docPath('bookings', bookingId)).data.status == 'delivered'
          && request.resource.data.amountPaise is int
          && request.resource.data.amountPaise >= 100 && request.resource.data.amountPaise <= 500000
          && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    function validIncentive() {
      let i = request.resource.data;
      return i.keys().hasOnly(['title', 'targetTrips', 'windowDays', 'bonusPaise', 'startsAt', 'active', 'createdAt', 'updatedAt'])
          && i.title is string && i.title.size() >= 2 && i.title.size() <= 60
          && i.targetTrips is int && i.targetTrips >= 1 && i.targetTrips <= 1000
          && i.windowDays is int && i.windowDays >= 1 && i.windowDays <= 365
          && i.bonusPaise is int && i.bonusPaise >= 1 && i.bonusPaise <= 10000000
          && i.startsAt is timestamp
          && i.active is bool;
    }
    match /incentives/{incentiveId} {
      allow read: if signedIn();
      allow create, update: if adminIn(['super']) && validIncentive();
      allow delete: if false;
    }
    match /incentive_claims/{claimId} {
      allow read: if signedIn() && (resource.data.driverId == request.auth.uid || isAdmin());
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['incentiveId', 'driverId', 'bonusPaise', 'status', 'createdAt'])
          && request.resource.data.driverId == request.auth.uid
          && claimId == request.resource.data.incentiveId + '_' + request.auth.uid
          && request.resource.data.status == 'claimed'
          && request.resource.data.createdAt == request.time
          && get(docPath('users', request.auth.uid)).data.get('role', 'driver') == 'driver'
          && canTransact(request.auth.uid)
          && get(docPath('incentives', request.resource.data.incentiveId)).data.active == true
          && request.resource.data.bonusPaise == get(docPath('incentives', request.resource.data.incentiveId)).data.bonusPaise
          && request.time >= get(docPath('incentives', request.resource.data.incentiveId)).data.startsAt
          && request.time <= get(docPath('incentives', request.resource.data.incentiveId)).data.startsAt
              + duration.value(get(docPath('incentives', request.resource.data.incentiveId)).data.windowDays + 7, 'd');
      allow update: if adminIn(['super', 'finance'])
          && changedKeys().hasOnly(['status', 'paidAt'])
          && resource.data.status == 'claimed'
          && request.resource.data.status == 'paid';
      allow delete: if false;
    }
    match /plan_requests/{driverUid} {
      allow read: if isUser(driverUid) || isAdmin();
      allow create: if isUser(driverUid)
          && request.resource.data.keys().hasOnly(['uid', 'plan', 'status', 'createdAt'])
          && request.resource.data.uid == driverUid
          && request.resource.data.plan == 'pro'
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
      allow update: if (isUser(driverUid)
              && resource.data.status in ['approved', 'rejected']
              && request.resource.data.keys().hasOnly(['uid', 'plan', 'status', 'createdAt'])
              && request.resource.data.uid == driverUid
              && request.resource.data.plan == 'pro'
              && request.resource.data.status == 'pending'
              && request.resource.data.createdAt == request.time)
          || (adminIn(['super']) && changedKeys().hasOnly(['status', 'answeredAt'])
              && request.resource.data.status in ['approved', 'rejected']);
      allow delete: if false;
    }
    function slotPath(code, n) {
      return /databases/$(database)/documents/promos/$(code)/slots/$(n);
    }
    function usePath(code, id) {
      return /databases/$(database)/documents/promos/$(code)/uses/$(id);
    }
    function creditPath(uid, id) {
      return /databases/$(database)/documents/users/$(uid)/credits/$(id);
    }
    function promoDiscount(p, total) {
      let raw = p.type == 'percent' ? math.floor(total * p.value / 100) : p.value;
      let capped = (p.get('maxDiscountPaise', 0) > 0 && raw > p.maxDiscountPaise) ? p.maxDiscountPaise : raw;
      return capped > total ? total : capped;
    }
    function promoUsable(p) {
      return p.active == true && p.expiresAt > request.time;
    }
    function validPromoDoc(code) {
      let p = request.resource.data;
      return p.keys().hasOnly(['code', 'type', 'value', 'maxDiscountPaise', 'minOrderPaise', 'expiresAt', 'usageLimit',
                               'perUserLimit', 'active', 'createdAt', 'updatedAt'])
          && p.code == code && code.matches('^[A-Z0-9]{3,20}$')
          && p.type in ['percent', 'flat']
          && p.value is int && p.value > 0
          && (p.type == 'flat' || p.value <= 100)
          && (p.type == 'percent' || p.value <= 10000000)
          && p.maxDiscountPaise is int && p.maxDiscountPaise >= 0 && p.maxDiscountPaise <= 10000000
          && p.minOrderPaise is int && p.minOrderPaise >= 0
          && p.expiresAt is timestamp
          && p.usageLimit is int && p.usageLimit >= 1 && p.usageLimit <= 100000
          && p.perUserLimit is int && p.perUserLimit >= 1 && p.perUserLimit <= 100
          && p.active is bool;
    }
    match /promos/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, update: if adminIn(['super']) && validPromoDoc(code);
      allow delete: if false;
      match /slots/{n} {
        allow get: if signedIn();
        allow list: if isAdmin();
        allow create: if signedIn()
            && n.matches('^[0-9]{1,6}$') && int(n) >= 1
            && int(n) <= get(docPath('promos', code)).data.usageLimit
            && promoUsable(get(docPath('promos', code)).data)
            && request.resource.data.keys().hasOnly(['loadId', 'createdAt'])
            && getAfter(docPath('loads', request.resource.data.loadId)).data.shipperId == request.auth.uid
            && getAfter(docPath('loads', request.resource.data.loadId)).data.promo.code == code
            && getAfter(docPath('loads', request.resource.data.loadId)).data.promo.slot == int(n);
        allow update, delete: if false;
      }
      match /uses/{useId} {
        allow get: if signedIn() && useId.matches('^' + request.auth.uid + '_[0-9]+$');
        allow list: if isAdmin();
        allow create: if signedIn()
            && useId.matches('^' + request.auth.uid + '_[0-9]{1,3}$')
            && int(useId.split('_')[1]) >= 1
            && int(useId.split('_')[1]) <= get(docPath('promos', code)).data.perUserLimit
            && request.resource.data.keys().hasOnly(['uid', 'loadId', 'createdAt'])
            && request.resource.data.uid == request.auth.uid
            && getAfter(docPath('loads', request.resource.data.loadId)).data.shipperId == request.auth.uid
            && getAfter(docPath('loads', request.resource.data.loadId)).data.promo.code == code
            && getAfter(docPath('loads', request.resource.data.loadId)).data.promo.use == int(useId.split('_')[1]);
        allow update, delete: if false;
      }
    }
    function offersOn(flag) {
      return exists(docPath('config', 'offers')) && get(docPath('config', 'offers')).data.get(flag, false) == true;
    }
    function validPromoOnCreate(loadId, d) {
      let pr = d.get('promo', null);
      let p = get(docPath('promos', pr.code)).data;
      let total = d.estimate.total;
      return offersOn('promoEnabled')
          && pr.keys().hasOnly(['code', 'discountPaise', 'slot', 'use'])
          && pr.slot is int && pr.use is int
          && 'estimate' in d
          && promoUsable(p)
          && total >= p.minOrderPaise
          && pr.discountPaise is int && pr.discountPaise > 0
          && pr.discountPaise == promoDiscount(p, total)
          && getAfter(slotPath(pr.code, string(pr.slot))).data.loadId == loadId
          && getAfter(usePath(pr.code, d.shipperId + '_' + string(pr.use))).data.loadId == loadId;
    }
    function validCreditsOnCreate(loadId, d) {
      let used = d.get('creditsUsedPaise', 0);
      return used is int && used >= 0
          && (used == 0 || getAfter(creditPath(d.shipperId, 'spend_' + loadId)).data.amountPaise == -used);
    }
    function offersCreateOk(loadId, d) {
      return (!('promo' in d) || validPromoOnCreate(loadId, d)) && validCreditsOnCreate(loadId, d);
    }
    function validPromoShape(d) {
      return !('promo' in d)
          || (d.promo is map && d.promo.code is string && d.promo.code.matches('^[A-Z0-9]{3,20}$'));
    }
    function referralBonus() {
      return exists(docPath('config', 'offers'))
          ? get(docPath('config', 'offers')).data.get('referralBonusPaise', 10000)
          : 10000;
    }
    match /users/{userId}/credits/{lineId} {
      allow read: if isUser(userId) || isAdmin();
      allow create: if signedIn()
          && request.resource.data.amountPaise is int
          && request.resource.data.keys().hasOnly(['amountPaise', 'kind', 'loadId', 'note', 'createdAt'])
          && ((isUser(userId) && request.resource.data.kind == 'spend'
                  && offersOn('creditsEnabled')
                  && request.resource.data.amountPaise < 0
                  && lineId == 'spend_' + request.resource.data.loadId
                  && getAfter(docPath('loads', request.resource.data.loadId)).data.shipperId == userId
                  && getAfter(docPath('loads', request.resource.data.loadId)).data.get('creditsUsedPaise', 0) == -request.resource.data.amountPaise
                  && -request.resource.data.amountPaise <= getAfter(docPath('loads', request.resource.data.loadId)).data.estimate.total)
              || (request.resource.data.kind == 'referral'
                  && offersOn('referralEnabled')
                  && request.resource.data.amountPaise == referralBonus()
                  && existsAfter(docPath('referrals', request.auth.uid))
                  && ((isUser(userId) && lineId == 'referral_in')
                      || (lineId == 'referral_from_' + request.auth.uid
                          && getAfter(docPath('referrals', request.auth.uid)).data.referrerUid == userId)))
              || (adminIn(['super']) && request.resource.data.kind in ['admin_grant', 'admin_deduct']
                  && request.resource.data.amountPaise != 0
                  && request.resource.data.amountPaise >= -100000000 && request.resource.data.amountPaise <= 100000000
                  && (!('note' in request.resource.data) || request.resource.data.note.size() <= 200)));
      allow update, delete: if false;
    }
    match /referral_codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
          && code.matches('^[A-Z0-9]{6,8}$')
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && getAfter(docPath('users', request.auth.uid)).data.referralCode == code;
      allow update, delete: if false;
    }
    match /referrals/{refereeUid} {
      allow read: if isUser(refereeUid) || isAdmin() || resource.data.referrerUid == request.auth.uid;
      allow create: if isUser(refereeUid)
          && offersOn('referralEnabled')
          && request.resource.data.keys().hasOnly(['referrerUid', 'code', 'createdAt'])
          && request.resource.data.referrerUid != request.auth.uid
          && get(docPath('referral_codes', request.resource.data.code)).data.uid == request.resource.data.referrerUid
          && get(docPath('users', request.auth.uid)).data.get('role', 'customer') == 'customer'
          && get(docPath('users', request.auth.uid)).data.createdAt > request.time - duration.value(7, 'd')
          && existsAfter(creditPath(request.auth.uid, 'referral_in'))
          && existsAfter(creditPath(request.resource.data.referrerUid, 'referral_from_' + request.auth.uid));
      allow update, delete: if false;
    }
    match /invite_codes/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if adminIn(['super', 'ops'])
          && code.matches('[A-Z2-9]{8}')
          && request.resource.data.keys().hasOnly(['role', 'route', 'maxUses', 'uses', 'expiresAt', 'active', 'createdBy', 'createdAt'])
          && request.resource.data.role in ['any', 'customer', 'driver', 'fleet']
          && request.resource.data.route is string && request.resource.data.route.size() <= 60
          && request.resource.data.maxUses is int && request.resource.data.maxUses >= 1 && request.resource.data.maxUses <= 1000
          && request.resource.data.uses == 0
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.active == true
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
      allow update: if (adminIn(['super', 'ops'])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']))
          || (signedIn()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses'])
              && resource.data.active == true
              && request.resource.data.uses == resource.data.uses + 1
              && request.resource.data.uses <= resource.data.maxUses
              && resource.data.expiresAt > request.time
              && existsAfter(docPath('invite_redemptions', request.auth.uid))
              && getAfter(docPath('invite_redemptions', request.auth.uid)).data.code == code);
      allow delete: if false;
    }
    match /invite_redemptions/{uid} {
      allow read: if isUser(uid) || isAdmin();
      allow create: if isUser(uid)
          && request.resource.data.keys().hasOnly(['code', 'role', 'createdAt'])
          && request.resource.data.code is string && request.resource.data.code.matches('[A-Z2-9]{8}')
          && request.resource.data.role in ['customer', 'driver', 'fleet']
          && request.resource.data.createdAt == request.time
          && getAfter(docPath('invite_codes', request.resource.data.code)).data.uses
              == get(docPath('invite_codes', request.resource.data.code)).data.uses + 1;
      allow update, delete: if false;
    }
    match /pilot_whitelist/{digits} {
      allow get: if signedIn() && digits == phoneDigits(request.auth.token.get('phone_number', ''));
      allow list: if isAdmin();
      allow create: if adminIn(['super', 'ops'])
          && digits.matches('[0-9]{10,15}')
          && request.resource.data.keys().hasOnly(['createdBy', 'createdAt'])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if adminIn(['super', 'ops']);
    }
    match /waitlist/{entryId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
          && entryId.matches(request.auth.uid + '_[a-z]{1,40}_[a-z]{1,40}')
          && request.resource.data.keys().hasOnly(['uid', 'role', 'from', 'to', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role in ['customer', 'driver', 'fleet']
          && request.resource.data.from is string && request.resource.data.from.size() >= 2 && request.resource.data.from.size() <= 40
          && request.resource.data.to is string && request.resource.data.to.size() >= 2 && request.resource.data.to.size() <= 40
          && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /dispatch_suggestions/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.driverId == request.auth.uid);
      allow create: if adminIn(['super', 'ops'])
          && request.resource.data.keys().hasOnly(['loadId', 'driverId', 'pickup', 'drop', 'weight', 'vehicleType', 'note', 'by', 'status', 'createdAt'])
          && request.resource.data.loadId is string && request.resource.data.driverId is string
          && id == request.resource.data.loadId + '_' + request.resource.data.driverId
          && request.resource.data.pickup is string && request.resource.data.pickup.size() <= 120
          && request.resource.data.drop is string && request.resource.data.drop.size() <= 120
          && request.resource.data.weight is number && request.resource.data.vehicleType is string && request.resource.data.vehicleType.size() <= 40
          && request.resource.data.note is string && request.resource.data.note.size() <= 300
          && request.resource.data.by == request.auth.uid
          && request.resource.data.status == 'suggested'
          && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.driverId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['seen', 'declined'];
      allow delete: if adminIn(['super', 'ops']) || (signedIn() && resource.data.driverId == request.auth.uid);
    }
    match /trip_surveys/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['bookingId', 'uid', 'role', 'answer', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.bookingId is string
          && id == request.resource.data.bookingId + '_' + request.auth.uid
          && request.resource.data.role in ['customer', 'driver']
          && request.resource.data.answer in ['yes', 'maybe', 'no']
          && request.resource.data.createdAt == request.time
          && get(docPath('bookings', request.resource.data.bookingId)).data.status == 'delivered'
          && (request.resource.data.role == 'customer'
                ? get(docPath('bookings', request.resource.data.bookingId)).data.customerId == request.auth.uid
                : request.auth.uid in [get(docPath('bookings', request.resource.data.bookingId)).data.get('driverId', ''), get(docPath('bookings', request.resource.data.bookingId)).data.get('fleetOwnerId', '')]);
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /payment_nudges/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if adminIn(['super', 'ops', 'support', 'finance'])
          && request.resource.data.keys().hasOnly(['bookingId', 'userId', 'target', 'by', 'count', 'lastAt'])
          && request.resource.data.target in ['customer', 'driver']
          && request.resource.data.bookingId is string && request.resource.data.userId is string
          && id == request.resource.data.bookingId + '_' + request.resource.data.target
          && request.resource.data.by == request.auth.uid
          && request.resource.data.count == 1
          && request.resource.data.lastAt == request.time;
      allow update: if adminIn(['super', 'ops', 'support', 'finance'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'lastAt', 'by'])
          && request.resource.data.count == resource.data.count + 1
          && request.resource.data.by == request.auth.uid
          && request.resource.data.lastAt == request.time
          && request.time > resource.data.lastAt + duration.value(6, 'h');
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
    match /config_history/{id} {
      allow read: if adminIn(['super']);
      allow create: if adminIn(['super'])
          && request.resource.data.keys().hasOnly(['docId', 'json', 'by', 'createdAt'])
          && request.resource.data.docId is string && request.resource.data.docId.size() >= 1 && request.resource.data.docId.size() <= 40
          && request.resource.data.json is string && request.resource.data.json.size() <= 30000
          && request.resource.data.by == request.auth.uid
          && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /credit_balances/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }
    match /trip_counts/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
      match /seen/{bookingId} {
        allow read, write: if false;
      }
    }
    match /route_rates/{key} {
      allow get: if signedIn();
      allow list, write: if false;
    }
    match /route_rates_seen/{bookingId} {
      allow read, write: if false;
    }
    match /public_trust/{uid} {
      allow get: if signedIn();
      allow list, write: if false;
    }
    match /reconciliation_reports/{day} {
      allow read: if isAdmin();
      allow write: if false;
    }
    function validUploadMeta(d, folder, id) {
      return d.size is int && d.size > 0 && d.size < 5 * 1024 * 1024
          && d.contentType is string && d.contentType.matches('image/(jpeg|png|webp|heic|heif)')
          && d.path is string && d.path.matches(folder + '/' + id + '[.][a-z0-9]{3,4}')
          && d.createdAt == request.time;
    }
    match /users/{userId}/uploads/{uploadId} {
      allow read: if isUser(userId) || isAdmin();
      allow create: if isUser(userId)
          && request.resource.data.keys().hasOnly(['kind', 'path', 'size', 'contentType', 'vehicleId', 'createdAt'])
          && (!('vehicleId' in request.resource.data)
              || (request.resource.data.vehicleId is string && request.resource.data.vehicleId.matches('[A-Za-z0-9_-]{1,128}')))
          && request.resource.data.kind in ['licence', 'rc', 'insurance', 'puc', 'permit', 'fitness']
          && validUploadMeta(request.resource.data, 'users/' + userId + '/docs/' + request.resource.data.kind, uploadId);
      allow update: if false;
      allow delete: if isUser(userId);
    }
    match /bookings/{bookingId}/proofs/{proofId} {
      function proofParty(b) {
        return request.auth.uid == b.driverId || request.auth.uid == b.get('assignedDriverId', '') || request.auth.uid == b.customerId;
      }
      allow read: if signedIn() && (proofParty(get(docPath('bookings', bookingId)).data) || isAdmin());
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['kind', 'path', 'size', 'contentType', 'by', 'createdAt'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.kind in ['pickup', 'delivery', 'pod', 'damage', 'seal']
          && validUploadMeta(request.resource.data, 'bookings/' + bookingId + '/' + request.resource.data.kind, proofId)
          && (request.resource.data.kind == 'damage'
              ? proofParty(get(docPath('bookings', bookingId)).data)
              : (request.auth.uid == get(docPath('bookings', bookingId)).data.driverId
                  || request.auth.uid == get(docPath('bookings', bookingId)).data.get('assignedDriverId', '')));
      allow update, delete: if false;
    }
    match /config/{docId} {
      allow read: if signedIn();
      allow create, update: if adminIn(['super']) && validConfig(docId);
      allow delete: if false;
    }
    function validNotification() {
      let n = request.resource.data;
      let b = getAfter(docPath('bookings', n.relatedId)).data;
      return n.keys().hasOnly(['userId', 'type', 'message', 'relatedId', 'status', 'read', 'createdAt'])
          && n.type in ['load_accepted', 'status_changed', 'rating_received', 'booking_cancelled', 'breakdown_reported', 'payment_marked', 'payment_confirmed', 'accident_reported', 'driver_arriving_soon', 'chat_message', 'trip_assigned', 'missed_call', 'lr_sent', 'inspection_request', 'inspection_approved', 'inspection_denied']
          && n.message is string && n.message.size() <= 200
          && n.read == false
          && n.userId != request.auth.uid
          && request.auth.uid in [b.driverId, b.customerId, b.get('assignedDriverId', ''), b.get('fleetOwnerId', '')]
          && n.userId in [b.driverId, b.customerId, b.get('assignedDriverId', ''), b.get('fleetOwnerId', '')];
    }
    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && validNotification();
      allow update: if signedIn()
          && resource.data.userId == request.auth.uid
          && changedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
