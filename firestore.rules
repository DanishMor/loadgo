          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
      allow update: if adminIn(['super', 'support', 'ops'])
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'handledBy', 'handledAt', 'note'])
          && request.resource.data.status in ['granted', 'rejected']
          && request.resource.data.handledBy == request.auth.uid
