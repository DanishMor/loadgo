            && request.resource.data.keys().hasOnly(['goodsValuePaise', 'invoiceNo', 'consignorGstin', 'consigneeGstin', 'ewayBillNo', 'ewayValidUntil', 'createdAt'])
            && request.resource.data.createdAt == request.time
            && request.resource.data.get('goodsValuePaise', 0) is int && request.resource.data.get('goodsValuePaise', 0) >= 0
            && request.resource.data.get('invoiceNo', '') is string && request.resource.data.get('invoiceNo', '').size() <= 40
            && request.resource.data.get('consignorGstin', '') is string && request.resource.data.get('consigneeGstin', '') is string
            && request.resource.data.get('ewayBillNo', '') is string && request.resource.data.get('ewayBillNo', '').size() <= 12;
        allow update, delete: if false;
      }
      match /inspection_grants/{driverId} {
